#!/bin/bash

PRGNAM=libX11

CWD=$(dirname "$0")
TMP=$MODULE_PATH/$PRGNAM
PKG=$TMP/package-$PRGNAM

set -e

[ -e $TMP ] && rm -rf $TMP
mkdir -p $TMP $PKG
cd $TMP

VERSION=$(curl -s https://gitlab.freedesktop.org/xorg/lib/${PRGNAM,,}/-/tags?format=atom | grep -oPm 20 '(?<= <title>)[^<]+' | rev | cut -d "-" -f 1 | rev | sort -Vr | head -1)
wget https://gitlab.freedesktop.org/xorg/lib/${PRGNAM,,}/-/archive/${PRGNAM}-${VERSION}/${PRGNAM,,}-${PRGNAM}-${VERSION}.tar.gz

tar xf ${PRGNAM,,}-$PRGNAM-$VERSION.tar.?z*
cd ${PRGNAM,,}-$PRGNAM-$VERSION

CFLAGS="${GCC_CFLAGS/-flto=auto/}" \
./autogen.sh \
	--prefix=/usr \
	--libdir=/usr/lib${SYSTEM_BITS} \
	--sysconfdir=/etc \
	--localstatedir=/var \
	--disable-static \
	--disable-specs \
	--enable-year2038 \
	--build=$ARCH-porteux-linux

make -j${NUMBER_THREADS} install-strip DESTDIR=$PKG

find $PKG -type f -name "*.la" -exec rm -f {} \;
rm -fr $PKG/usr/share/doc
rm -fr $PKG/usr/share/man

mkdir -p $PKG/install
cat $CWD/slack-desc > $PKG/install/slack-desc

cd $PKG
makepkg ${MAKEPKG_FLAGS} $MODULE_PATH/packages/$PRGNAM-$VERSION-$ARCH-1_porteux.txz