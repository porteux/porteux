diff --git a/gdk/wayland/gdkeventsource.c b/gdk/wayland/gdkeventsource.c
index 7016af9..e61df11 100644
--- a/gdk/wayland/gdkeventsource.c
+++ b/gdk/wayland/gdkeventsource.c
@@ -142,6 +142,18 @@ gdk_event_source_finalize (GSource *base)
   source->reading = FALSE;
 }
 
+void
+_gdk_wayland_display_cancel_read (GdkWaylandDisplay *display_wayland)
+{
+  GdkWaylandEventSource *source = (GdkWaylandEventSource *) display_wayland->event_source;
+
+  if (source == NULL || !source->reading)
+    return;
+
+  wl_display_cancel_read (display_wayland->wl_display);
+  source->reading = FALSE;
+}
+
