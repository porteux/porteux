+GdkModifierType
+_gtk_drag_source_get_start_button_mask (GtkWidget *widget)
+{
+  GtkDragSourceSite *site;
+
+  site = g_object_get_data (G_OBJECT (widget), "gtk-site-data");
+
+  return site ? site->start_button_mask : 0;
