+static gboolean
+gtk_icon_view_drag_source_hit_test (GtkWidget      *widget,
+                                    GdkEventButton *event)
+{
+  GtkIconView *icon_view = GTK_ICON_VIEW (widget);
+
+  if (event->window != icon_view->priv->bin_window)
+    return FALSE;
+
+  if (icon_view->priv->source_set &&
+      !(icon_view->priv->start_button_mask & (GDK_BUTTON1_MASK << (event->button - 1))))
+    return FALSE;
+
+  return _gtk_icon_view_get_item_at_coords (icon_view, event->x, event->y, TRUE, NULL) != NULL;
+}
+
 static void
 gtk_icon_view_init (GtkIconView *icon_view)
 {
   icon_view->priv = gtk_icon_view_get_instance_private (icon_view);
 
+  g_object_set_data (G_OBJECT (icon_view), I_("gtk-drag-source-hit-test"),
+                     (gpointer) gtk_icon_view_drag_source_hit_test);
+
   icon_view->priv->width = 0;
   icon_view->priv->height = 0;
   icon_view->priv->selection_mode = GTK_SELECTION_SINGLE;
