+#ifdef GDK_WINDOWING_X11
+typedef gboolean (*GtkDragSourceHitTestFunc) (GtkWidget      *widget,
+                                              GdkEventButton *event);
+
+static gboolean
+gtk_widget_chain_is_drag_source (GtkWidget      *event_widget,
+                                 GdkEventButton *event)
+{
+  static GQuark site_quark = 0;
+  static GQuark hit_test_quark = 0;
+  static guint drag_begin_id = 0;
+  static guint drag_data_get_id = 0;
+  GtkDragSourceHitTestFunc hit_test;
+  GdkModifierType start_button_mask;
+  GtkWidget *widget;
+
+  if (!site_quark)
+    {
+      site_quark = g_quark_from_static_string ("gtk-site-data");
+      hit_test_quark = g_quark_from_static_string ("gtk-drag-source-hit-test");
+      drag_begin_id = g_signal_lookup ("drag-begin", GTK_TYPE_WIDGET);
+      drag_data_get_id = g_signal_lookup ("drag-data-get", GTK_TYPE_WIDGET);
+    }
+
+  for (widget = event_widget; widget; widget = gtk_widget_get_parent (widget))
+    {
+      if (g_object_get_qdata (G_OBJECT (widget), site_quark) ||
+          g_signal_has_handler_pending (widget, drag_begin_id, 0, TRUE) ||
+          g_signal_has_handler_pending (widget, drag_data_get_id, 0, TRUE))
+        {
+          start_button_mask = _gtk_drag_source_get_start_button_mask (widget);
+          if (start_button_mask && !(start_button_mask & (GDK_BUTTON1_MASK << (event->button - 1))))
+            return FALSE;
+          hit_test = (GtkDragSourceHitTestFunc) g_object_get_qdata (G_OBJECT (widget), hit_test_quark);
+          return hit_test ? hit_test (widget, event) : TRUE;
+        }
+    }
+
+  return FALSE;
+}
+
+static Window activate_on_release_xid = None;
+static guint activate_on_release_button = 0;
+
+static void
+gtk_main_send_activate_on_click (GdkDisplay *display,
+                                 Window      xid,
+                                 guint32     time,
+                                 guint       button,
+                                 gboolean    on_release)
+{
+  XClientMessageEvent xev = { 0 };
+
+  xev.type = ClientMessage;
+  xev.window = xid;
+  xev.message_type = gdk_x11_get_xatom_by_name_for_display (display, "_GTK_ACTIVATE_ON_CLICK");
+  xev.format = 32;
+  xev.data.l[0] = time;
+  xev.data.l[1] = button;
+  xev.data.l[2] = on_release;
+  XSendEvent (GDK_DISPLAY_XDISPLAY (display),
+              DefaultRootWindow (GDK_DISPLAY_XDISPLAY (display)),
+              False, SubstructureRedirectMask, (XEvent *) &xev);
+  gdk_display_flush (display);
+}
+#endif
+
+void
+_gtk_main_cancel_activate_on_release (void)
+{
+#ifdef GDK_WINDOWING_X11
+  activate_on_release_xid = None;
+#endif
+}
+
+static void
+gtk_main_activate_on_click (GtkWidget      *event_widget,
+                            GdkEventButton *event)
+{
+#ifdef GDK_WINDOWING_X11
+  GdkWindow *toplevel;
+  gboolean on_release;
+
+  if (!GDK_IS_X11_WINDOW (event->window))
+    return;
+
+  if (event->type == GDK_BUTTON_RELEASE)
+    {
+      if (activate_on_release_xid && event->button == activate_on_release_button)
+        {
+          gtk_main_send_activate_on_click (gdk_window_get_display (event->window),
+                                           activate_on_release_xid, event->time, event->button, FALSE);
+          activate_on_release_xid = None;
+        }
+      return;
+    }
+
+  if (activate_on_release_xid &&
+      (event->state & (GDK_BUTTON1_MASK << (activate_on_release_button - 1))))
+    return;
+
+  activate_on_release_xid = None;
+
+  if (event->button > 3)
+    return;
+
+  toplevel = gdk_window_get_toplevel (event->window);
+  if (!gdk_x11_screen_supports_net_wm_hint (gdk_window_get_screen (toplevel),
+                                            gdk_atom_intern_static_string ("_GTK_ACTIVATE_ON_CLICK")))
+    return;
+
+  on_release = gtk_widget_chain_is_drag_source (event_widget, event);
+  if (on_release)
+    {
+      activate_on_release_xid = GDK_WINDOW_XID (toplevel);
+      activate_on_release_button = event->button;
+    }
+
+  gtk_main_send_activate_on_click (gdk_window_get_display (toplevel),
+                                   GDK_WINDOW_XID (toplevel), event->time, event->button, on_release);
+#endif
+}
