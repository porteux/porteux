#!/bin/bash

source "$BUILDER_UTILS_PATH/latest-from-github.sh"

PRGNAM=ostree

CWD=$(dirname "$0")
TMP=$MODULE_PATH/$PRGNAM
PKG=$TMP/package-$PRGNAM

set -e

[ -e $TMP ] && rm -rf $TMP
mkdir -p $TMP $PKG
cd $TMP

VERSION=$(get_latest_version_tag_from_github "ostreedev" ${PRGNAM})
wget https://github.com/ostreedev/${PRGNAM}/releases/download/${VERSION}/lib${PRGNAM}-${VERSION//[vV]}.tar.xz

tar xf lib${PRGNAM}-${VERSION//[vV]}.tar.?z*
cd lib${PRGNAM}-${VERSION//[vV]}

CFLAGS="$GCC_CFLAGS -ffat-lto-objects" \
./configure \
	--prefix=/usr \
	--libdir=/usr/lib${SYSTEM_BITS} \
	--localstatedir=/var \
	--sysconfdir=/etc \
	--disable-introspection \
	--disable-installed-tests \
	--disable-always-build-tests \
	--disable-glibtest \
	--disable-gtk-doc \
	--disable-gtk-doc-html \
	--disable-gtk-doc-pdf \
	--disable-man \
	--disable-man-html

make -j${NUMBER_THREADS} install DESTDIR=$PKG

find $PKG -type f -name "*.la" -delete

rm -fr $PKG/usr/lib
rm -fr $PKG/etc/ostree

mkdir -p $PKG/install
cat $CWD/slack-desc > $PKG/install/slack-desc

cd $PKG
makepkg ${MAKEPKG_FLAGS} $MODULE_PATH/packages/lib${PRGNAM}-${VERSION//[vV]}-$ARCH-1_porteux.txz
