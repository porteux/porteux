+bool wlr_xwayland_hold_clients(struct wlr_xwayland *xwayland) {
+	if (xwayland->server == NULL || xwayland->server->ready ||
+			!wlr_xwayland_server_open_init_display(xwayland->server)) {
+		return false;
+	}
+	xwayland->hold_clients = true;
+	return true;
+}
+
+void wlr_xwayland_release_clients(struct wlr_xwayland *xwayland) {
+	struct wlr_xwayland_server *server = xwayland->server;
+	if (server == NULL || !server->ready || xwayland->xwm != NULL ||
+			server->wm_fd[0] < 0) {
+		return;
+	}
+	xwayland_mark_ready(xwayland);
+}
