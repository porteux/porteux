+bool wlr_xwayland_server_open_init_display(struct wlr_xwayland_server *server) {
+#if HAVE_XWAYLAND_INITFD
+	if (server->init_display < 0 && server->display >= 0) {
+		server->init_display = open_init_display_socket(server->init_fd);
+		snprintf(server->init_display_name, sizeof(server->init_display_name),
+			":%d", server->init_display);
+	}
+	return server->init_display >= 0;
+#else
+	return false;
+#endif
+}
+
+const char *wlr_xwayland_server_get_init_display_name(
+		struct wlr_xwayland_server *server) {
+	return server->init_display >= 0 ? server->init_display_name : NULL;
+}
