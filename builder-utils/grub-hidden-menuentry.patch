+static void
+hide_last_visible_entry (void)
+{
+  grub_menu_t menu = grub_env_get_menu ();
+  grub_menu_entry_t entry;
+  int i;
+
+  if (! menu || menu->size <= 0)
+    return;
+
+  for (i = 1, entry = menu->entry_list; entry && i < menu->size; i++)
+    entry = entry->next;
+
+  if (entry)
+    {
+      entry->hidden = 1;
+      menu->size--;
+    }
+}
