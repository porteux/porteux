libntfs: stop on short or failed writes

- ntfs_pwrite(): a write that stores less than asked counts as a failed
  write
- a failed device flush counts as a failed write too
- on an ntfsck volume the device then takes no more writes, so ntfsck exits
  8 without 'Clean' and keeps the dirty flag; other tools only count it
- ntfs_repair_write_failed() no longer counts a failure the device already
  counted
- ntfs_rl_pwrite()/ntfs_rl_pread() stop at a short transfer instead of
  going on to the next run with data meant for the previous one

diff --git a/include/device.h b/include/device.h
--- a/include/device.h
+++ b/include/device.h
@@ -43,6 +43,8 @@ typedef enum {
 	ND_Dirty,	/* 1: Device is dirty, needs sync. */
 	ND_Block,	/* 1: Device is a block device. */
 	ND_Sync,	/* 1: Device is mounted with "-o sync" */
+	ND_Fsck,
+	ND_WriteFailed,
 } ntfs_device_state_bits;
 
 #define  test_ndev_flag(nd, flag)	   test_bit(ND_##flag, (nd)->d_state)
@@ -69,6 +71,12 @@ typedef enum {
 #define NDevSetSync(nd)		  set_ndev_flag(nd, Sync)
 #define NDevClearSync(nd)	clear_ndev_flag(nd, Sync)
 
+#define NDevFsck(nd)		 test_ndev_flag(nd, Fsck)
+#define NDevSetFsck(nd)		  set_ndev_flag(nd, Fsck)
+
+#define NDevWriteFailed(nd)	 test_ndev_flag(nd, WriteFailed)
+#define NDevSetWriteFailed(nd)	  set_ndev_flag(nd, WriteFailed)
+
 /**
  * struct ntfs_device -
  *
diff --git a/libntfs/device.c b/libntfs/device.c
--- a/libntfs/device.c
+++ b/libntfs/device.c
@@ -264,18 +264,24 @@ s64 ntfs_pwrite(struct ntfs_device *dev, const s64 pos, s64 count,
 		/* If everything ok, continue. */
 		if (written > 0)
 			continue;
-		/*
-		 * If nothing written or error return number of bytes written.
-		 */
-		if (!written || total)
-			break;
-		/* Nothing written and error, return error status. */
-		total = written;
 		break;
 	}
-	if (NDevSync(dev) && total && dops->sync(dev)) {
-		total--; /* on sync error, return partially written */
-	}
+	if (count) {
+		int err = written < 0 ? errno : EIO;
+
+		ntfs_log_error("Write of %lld bytes at %lld stopped after %lld bytes\n",
+				(long long)(count + total), (long long)pos,
+				(long long)total);
+		fsck_write_failures++;
+		fsck_operational_errors++;
+		NDevSetWriteFailed(dev);
+		if (NDevFsck(dev))
+			NDevSetReadOnly(dev);
+		errno = err;
+		return total ? total : -1;
+	}
+	if (NDevSync(dev) && total && dops->sync(dev))
+		total--;
 	ret = total;
 out:
 	return ret;
diff --git a/libntfs/runlist.c b/libntfs/runlist.c
--- a/libntfs/runlist.c
+++ b/libntfs/runlist.c
@@ -1314,6 +1314,8 @@ retry:
 			total += bytes_read;
 			count -= bytes_read;
 			b = (u8*)b + bytes_read;
+			if (bytes_read < to_read)
+				return total;
 			continue;
 		}
 		/* If the syscall was interrupted, try again. */
@@ -1410,6 +1412,8 @@ retry:
 			total += written;
 			count -= written;
 			b = (u8*)b + written;
+			if (written < to_write)
+				goto out;
 			continue;
 		}
 		/* If the syscall was interrupted, try again. */
diff --git a/libntfs/unix_io.c b/libntfs/unix_io.c
--- a/libntfs/unix_io.c
+++ b/libntfs/unix_io.c
@@ -379,9 +379,14 @@ static int ntfs_device_unix_io_sync(struct ntfs_device *dev)
 
 	if (!NDevReadOnly(dev)) {
 		res = ntfs_fsync(DEV_FD(dev));
-		if (res)
+		if (res) {
 			ntfs_log_perror("Failed to sync device %s", dev->d_name);
-		else
+			fsck_write_failures++;
+			fsck_operational_errors++;
+			NDevSetWriteFailed(dev);
+			if (NDevFsck(dev))
+				NDevSetReadOnly(dev);
+		} else
 			NDevClearDirty(dev);
 	}
 	return res;
diff --git a/libntfs/volume.c b/libntfs/volume.c
--- a/libntfs/volume.c
+++ b/libntfs/volume.c
@@ -97,8 +97,10 @@ int fsck_operational_errors;
  */
 static void ntfs_repair_write_failed(ntfs_volume *vol)
 {
-	fsck_write_failures++;
-	fsck_operational_errors++;
+	if (!vol->dev || !NDevWriteFailed(vol->dev)) {
+		fsck_write_failures++;
+		fsck_operational_errors++;
+	}
 	NVolSetReadOnly(vol);
 	if (vol->dev)
 		NDevSetReadOnly(vol->dev);
@@ -931,8 +933,10 @@ ntfs_volume *ntfs_volume_startup(struct ntfs_device *dev,
 	if (flags & NTFS_MNT_RDONLY)
 		NVolSetReadOnly(vol);
 
-	if (flags & NTFS_MNT_FSCK)
+	if (flags & NTFS_MNT_FSCK) {
 		NVolSetFsck(vol);
+		NDevSetFsck(dev);
+	}
 
 	if (flags & NTFS_MNT_FS_YES_REPAIR)
 		NVolSetFsYesRepair(vol);
