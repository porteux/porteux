+static int ntfsck_index_has_entry(ntfs_inode *parent_ni, ntfs_inode *ni,
+		FILE_NAME_ATTR *fn)
+{
+	ntfs_index_context *ictx;
+	int found;
+
+	ictx = ntfs_index_ctx_get(parent_ni, NTFS_INDEX_I30, 4);
+	if (!ictx)
+		return -1;
+	if (ntfs_index_lookup(fn, sizeof(FILE_NAME_ATTR), ictx))
+		found = errno == ENOENT ? 0 : -1;
+	else
+		found = MREF_LE(ictx->entry->indexed_file) == ni->mft_no;
+	ntfs_index_ctx_put(ictx);
+	return found;
+}
+
+static BOOL ntfsck_undo_index_add(ntfs_inode *parent_ni, ntfs_inode *ni,
+		FILE_NAME_ATTR *fn, int fn_len)
+{
+	int found = ntfsck_index_has_entry(parent_ni, ni, fn);
+
+	return !found || (found > 0 && !ntfs_index_remove(parent_ni, ni, fn, fn_len));
+}
