libntfs: keep volume flag bits it does not know

- ntfs_volume_write_flags() cleared every bit outside VOLUME_FLAGS_MASK, so
  each ntfsck -a wiped settings like 0x0080 and Windows' check requests
  (0x0100, 0x0200); those bits now keep their on-disk value

diff --git a/libntfs/volume.c b/libntfs/volume.c
--- a/libntfs/volume.c
+++ b/libntfs/volume.c
@@ -2791,7 +2791,8 @@ int ntfs_volume_write_flags(ntfs_volume *vol, const le16 flags)
 		goto err_out;
 	}
 	/* Set the volume flags. */
-	vol->flags = c->flags = flags & VOLUME_FLAGS_MASK;
+	vol->flags = c->flags = (c->flags & ~VOLUME_FLAGS_MASK) |
+		(flags & VOLUME_FLAGS_MASK);
 	/* Write them to disk. */
 	ntfs_inode_mark_dirty(vol->vol_ni);
 	if (ntfs_inode_sync(vol->vol_ni))
