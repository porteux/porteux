#!/bin/bash

source "$BUILDER_UTILS_PATH/latest-from-github.sh"

PRGNAM=zstd

CWD=$(dirname "$0")
TMP=$MODULE_PATH/$PRGNAM
PKG=$TMP/package-$PRGNAM

set -e

[ -e $TMP ] && rm -rf $TMP
mkdir -p $TMP $PKG
cd $TMP

#info=$(download_latest_from_github "facebook" ${PRGNAM} "kernel")
#VERSION=${info#* }
wget https://github.com/facebook/zstd/archive/refs/heads/dev.tar.gz
tar xf dev.tar.?z
cd $PRGNAM-dev
VERSION=$(date -r . +%Y%m%d)

cd build/cmake
CC=clang \
CXX=clang++ \
LDFLAGS="$LLDFLAGS" \
cmake -B build -S . \
	-G Ninja \
	-DCMAKE_BUILD_TYPE=Release \
	-DCMAKE_C_FLAGS="$CLANG_CFLAGS" \
	-DCMAKE_CXX_FLAGS="$CLANG_CXXFLAGS" \
	-DCMAKE_INSTALL_PREFIX=/usr \
	-DCMAKE_INSTALL_LIBDIR=lib${SYSTEM_BITS} \
	-DBUILD_SHARED_LIBS=ON \
	-DZSTD_BUILD_STATIC=OFF \
	-DZSTD_PROGRAMS_LINK_SHARED=ON \
	-DZSTD_LZ4_SUPPORT=ON \
	-DZSTD_LZMA_SUPPORT=ON \
	-DZSTD_ZLIB_SUPPORT=ON \
	-DZSTD_BUILD_TESTS=OFF

DESTDIR="$PKG" ninja -C build install -j${NUMBER_THREADS}

find $PKG -type f -name "*.la" -exec rm -f {} \;

mkdir -p $PKG/install
cat $CWD/slack-desc > $PKG/install/slack-desc

cd $PKG
makepkg ${MAKEPKG_FLAGS} $MODULE_PATH/packages/$PRGNAM-$VERSION-$ARCH-1_porteux.txz
