#!/bin/bash

source "$BUILDER_UTILS_PATH/latest-from-github.sh"

PRGNAM=squashfs-tools

CWD=$(dirname "$0")
TMP=$MODULE_PATH/$PRGNAM
PKG=$TMP/package-$PRGNAM

set -e

[ -e $TMP ] && rm -rf $TMP
mkdir -p $TMP $PKG
cd $TMP

info=$(download_latest_from_github "plougher" ${PRGNAM} "squashfs-tools|CVE")
VERSION=${info#* }

tar xf $PRGNAM-$VERSION.tar.?z*
cd $PRGNAM-$VERSION

cd $PRGNAM

CFLAGS="$GCC_CFLAGS" \
make -j${NUMBER_THREADS} \
	GZIP_SUPPORT="1" \
	XZ_SUPPORT="1" \
	LZ4_SUPPORT="1" \
	LZO_SUPPORT="1" \
	LZMA_XZ_SUPPORT="1" \
	ZSTD_SUPPORT="1" \
	COMP_DEFAULT="zstd"

make install INSTALL_DIR=$PKG/usr/bin

find $PKG -type f -name "*.la" -delete

mkdir -p $PKG/install
cat $CWD/slack-desc > $PKG/install/slack-desc

cd $PKG
makepkg ${MAKEPKG_FLAGS} $MODULE_PATH/packages/$PRGNAM-$VERSION-$ARCH-1_porteux.txz
