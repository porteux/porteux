#!/bin/bash

source "$BUILDER_UTILS_PATH/latest-from-github.sh"

PRGNAM=libxcrypt

CWD=$(dirname "$0")
TMP=$MODULE_PATH/$PRGNAM

set -e

[ -e $TMP ] && rm -rf $TMP
mkdir -p $TMP
cd $TMP

info=$(download_latest_from_github "besser82" ${PRGNAM})
VERSION=${info#* }

tar xvf $PRGNAM-$VERSION.tar.?z
cd $PRGNAM-$VERSION

CFLAGS="$GCC_CFLAGS -Wno-error=discarded-qualifiers" \
./configure \
	--prefix=/usr \
	--libdir=/usr/lib${SYSTEM_BITS} \
	--disable-static \
	--enable-hashes=strong,glibc \
	--enable-obsolete-api=no \
	--disable-failure-tokens \
	--build=$ARCH-slackware-linux

make -j$NUMBER_THREADS install DESTDIR="${PKG:?PKG is unset}"

rm -f $PKG/{,usr/}lib${SYSTEM_BITS}/libcrypt*.la
rm -fr $PKG/usr/share/man

# Move libraries out of /usr:
mkdir -p $PKG/lib${SYSTEM_BITS}
cd $PKG/usr/lib${SYSTEM_BITS}
rm libcrypt*.so
mv libcrypt*so* ../../lib${SYSTEM_BITS}

# Add .so symlinks for libcrypt and libxcrypt:
ln -sf ../../lib${SYSTEM_BITS}/libcrypt.so.2 libcrypt.so
ln -sf ../../lib${SYSTEM_BITS}/libcrypt.so.2 libxcrypt.so

rm -fr $TMP