#!/bin/bash

source "$BUILDER_UTILS_PATH/latest-from-github.sh"

PRGNAM=duktape

CWD=$(dirname "$0")
TMP=$MODULE_PATH/$PRGNAM
PKG=$TMP/package-$PRGNAM

set -e

[ -e $TMP ] && rm -rf $TMP
mkdir -p $TMP $PKG
cd $TMP

info=$(download_latest_from_github "svaarala" ${PRGNAM})
VERSION=${info#* }

tar xf $PRGNAM-$VERSION.tar.?z
cd $PRGNAM-$VERSION

sed -i 's/^#undef DUK_USE_FASTINT$/#define DUK_USE_FASTINT/' src/duk_config.h
sed -i 's/duktape\.c/& -lm/' Makefile.sharedlibrary

CFLAGS="$GCC_CFLAGS" \
make -j${NUMBER_THREADS} -f Makefile.sharedlibrary LIBDIR=/lib${SYSTEM_BITS} INSTALL_PREFIX=/usr DESTDIR=$PKG install

rm $PKG/usr/lib${SYSTEM_BITS}/libduktaped.*

mkdir -p $PKG/install
cat $CWD/slack-desc > $PKG/install/slack-desc

cd $PKG
makepkg ${MAKEPKG_FLAGS} $MODULE_PATH/packages/$PRGNAM-$VERSION-$ARCH-1_porteux.txz