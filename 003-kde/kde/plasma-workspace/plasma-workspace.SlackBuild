#!/bin/bash

PRGNAM=plasma-workspace

CWD=$(dirname "$0")
TMP=$MODULE_PATH/$PRGNAM
PKG=$TMP/package-$PRGNAM

set -e

[ -e $TMP ] && rm -rf $TMP
mkdir -p $TMP $PKG
cd $TMP

VERSION=$(curl -sL https://download.kde.org/stable/plasma/${PLASMA_VERSION}/ | grep -oP "href=\"${PRGNAM}-\K[0-9.]+(?=\.tar\.xz\")" | sort -Vr | head -1)
wget https://download.kde.org/stable/plasma/${PLASMA_VERSION}/${PRGNAM}-${VERSION}.tar.xz

tar xf $PRGNAM-$VERSION.tar.xz
cd $PRGNAM-$VERSION

for i in $CWD/*.patch; do
	patch -p1 < "$i"
done

cmake -B build -S . \
	-G Ninja \
	-DBUILD_TESTING=OFF \
	-DCMAKE_AR=/usr/bin/gcc-ar \
	-DCMAKE_BUILD_TYPE=Release \
	-DCMAKE_C_FLAGS="$GCC_CFLAGS" \
	-DCMAKE_CXX_FLAGS="$GCC_CXXFLAGS" \
	-DCMAKE_DISABLE_FIND_PACKAGE_KF6DocTools=ON \
	-DCMAKE_INSTALL_PREFIX=/usr \
	-DCMAKE_RANLIB=/usr/bin/gcc-ranlib \
	-DKDE_INSTALL_LIBDIR=lib${SYSTEM_BITS} \
	-DKDE_INSTALL_LIBEXECDIR=/usr/libexec \
	-DKDE_INSTALL_SYSCONFDIR=/etc \
	-DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
	-DWITH_X11_SESSION=OFF

DESTDIR=$PKG ninja -C build -j${NUMBER_THREADS} install

find $PKG -type f -name "*.la" -delete

install -Dm644 $CWD/kde.pam $PKG/etc/pam.d/kde

rm $PKG/etc/xdg/autostart/xembedsniproxy.desktop
rm $PKG/usr/share/dbus-1/services/org.kde.runners.baloo.service
mv $PKG/usr/libexec/baloorunner $PKG/usr/libexec/baloorunner_
find $PKG/usr/share/plasma/avatars -mindepth 1 -maxdepth 1 -type f -delete
find $PKG/usr/share/plasma/avatars/photos -mindepth 1 ! \( -name "Air Balloon.png" -o -name "Air Balloon.png.license" -o -name "Astronaut.png" -o -name "Astronaut.png.license" \) -exec rm -rf '{}' +

mkdir -p $PKG/install
cat $CWD/slack-desc > $PKG/install/slack-desc

cd $PKG
makepkg ${MAKEPKG_FLAGS} $MODULE_PATH/packages/$PRGNAM-$VERSION-$ARCH-1_porteux.txz
