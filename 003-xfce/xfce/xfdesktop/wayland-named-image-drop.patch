+static const gchar *
+skip_spaces(const gchar *p) {
+    while (*p == ' ' || *p == '\t') {
+        p++;
+    }
+    return p;
+}
+
+static gchar *
+read_param_value(const gchar **cursor) {
+    const gchar *p = *cursor;
+    GString *value = g_string_new(NULL);
+
+    if (*p == '"') {
+        for (p++; *p != '\0' && *p != '"'; p++) {
+            if (*p == '\\' && p[1] != '\0') {
+                p++;
+            }
+            g_string_append_c(value, *p);
+        }
+        if (*p == '"') {
+            p++;
+        }
+    } else {
+        for (; *p != '\0' && *p != ';' && *p != ' ' && *p != '\t'; p++) {
+            g_string_append_c(value, *p);
+        }
+    }
+
+    *cursor = p;
+    return g_string_free(value, FALSE);
+}
+
+static gchar *
+named_octet_stream_filename(GdkAtom target) {
+    static const gchar base[] = APPLICATION_OCTET_STREAM_NAME;
+
+    gchar *type = gdk_atom_name(target);
+    gchar *filename = NULL;
+    if (type != NULL && g_ascii_strncasecmp(type, base, strlen(base)) == 0) {
+        const gchar *p = skip_spaces(type + strlen(base));
+        while (filename == NULL && *p == ';') {
+            const gchar *key = skip_spaces(p + 1);
+            for (p = key; *p != '\0' && *p != '=' && *p != ';' && *p != ' ' && *p != '\t'; p++) {
+            }
+            gsize key_length = p - key;
+            p = skip_spaces(p);
+            if (*p != '=') {
+                continue;
+            }
+            p = skip_spaces(p + 1);
+            gchar *value = read_param_value(&p);
+            if (key_length == 4 && g_ascii_strncasecmp(key, "name", 4) == 0) {
+                filename = value;
+            } else {
+                g_free(value);
+            }
+            p = skip_spaces(p);
+        }
+    }
+    g_free(type);
+
+    if (filename != NULL
+        && (filename[0] == '\0'
+            || strchr(filename, G_DIR_SEPARATOR) != NULL
+            || g_strcmp0(filename, ".") == 0
+            || g_strcmp0(filename, "..") == 0))
+    {
+        g_clear_pointer(&filename, g_free);
+    }
+
+    return filename;
+}
+
+static GdkAtom
+named_drop_target(GtkWidget *icon_view) {
+    return GDK_POINTER_TO_ATOM(g_object_get_data(G_OBJECT(icon_view), NAMED_DROP_TARGET_KEY));
+}
+
+static gboolean
+is_named_drop_target(GtkWidget *icon_view, GdkAtom target) {
+    return target != GDK_NONE && target == named_drop_target(icon_view);
+}
+
+static GdkAtom
+find_drop_target(GtkWidget *icon_view, GdkDragContext *context, GtkTargetList *targets) {
+    GdkAtom target = gtk_drag_dest_find_target(icon_view, context, targets);
+    if (target != GDK_NONE && target != gdk_atom_intern_static_string(APPLICATION_OCTET_STREAM_NAME)) {
+        return target;
+    }
+
+    for (GList *l = gdk_drag_context_list_targets(context); l != NULL; l = l->next) {
+        GdkAtom named = GDK_POINTER_TO_ATOM(l->data);
+        gchar *filename = named_octet_stream_filename(named);
+        if (filename != NULL) {
+            g_free(filename);
+            gtk_target_list_remove(targets, named_drop_target(icon_view));
+            gtk_target_list_add(targets, named, 0, TARGET_APPLICATION_OCTET_STREAM);
+            g_object_set_data(G_OBJECT(icon_view), NAMED_DROP_TARGET_KEY, GDK_ATOM_TO_POINTER(named));
+            return named;
+        }
+    }
+
+    return target;
+}
