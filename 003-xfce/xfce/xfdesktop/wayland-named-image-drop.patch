+
+static gboolean
+handle_named_octet_stream_drop(MonitorData *mdata, GdkAtom target, gint x, gint y) {
+    if (!icon_is_writable_directory(mdata->fmanager->icon_on_drop_dest)) {
+        return FALSE;
+    }
+
+    gchar *filename = named_octet_stream_filename(target);
+    if (filename == NULL) {
+        return FALSE;
+    }
+    set_save_destination(mdata, filename, x, y);
+    g_free(filename);
+    return TRUE;
+}
