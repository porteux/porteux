+static gboolean
+pixmap_format_matches_image(Display *dpy, cairo_surface_t *surface, gint depth) {
+#if CAIRO_HAS_XLIB_XRENDER_SURFACE
+    XRenderPictFormat *format = cairo_xlib_surface_get_xrender_format(surface);
+    if (format == NULL
+        || format->type != PictTypeDirect
+        || format->depth != depth
+        || format->direct.red != 16 || format->direct.redMask != 0xff
+        || format->direct.green != 8 || format->direct.greenMask != 0xff
+        || format->direct.blue != 0 || format->direct.blueMask != 0xff
+        || (depth == 32 && (format->direct.alpha != 24 || format->direct.alphaMask != 0xff)))
+    {
+        return FALSE;
+    }
+
+    gboolean matches = FALSE;
+    gint n_formats = 0;
+    XPixmapFormatValues *formats = XListPixmapFormats(dpy, &n_formats);
+    for (gint i = 0; i < n_formats; ++i) {
+        if (formats[i].depth == depth) {
+            matches = formats[i].bits_per_pixel == 32;
+            break;
+        }
+    }
+    if (formats != NULL) {
+        XFree(formats);
+    }
+
+    return matches;
+#else
+    return FALSE;
+#endif
+}
+
+cairo_surface_t *
+xfdesktop_x11_upload_image_surface(GdkScreen *gscreen, cairo_surface_t *image) {
+    g_return_val_if_fail(cairo_surface_get_type(image) == CAIRO_SURFACE_TYPE_IMAGE, NULL);
+
+    GdkDisplay *gdisplay = gdk_screen_get_display(gscreen);
+    Display *dpy = GDK_SCREEN_XDISPLAY(gscreen);
+    Screen *xscreen = GDK_SCREEN_XSCREEN(gscreen);
+    gint width = cairo_image_surface_get_width(image);
+    gint height = cairo_image_surface_get_height(image);
+    gint depth = cairo_image_surface_get_format(image) == CAIRO_FORMAT_ARGB32 ? 32 : 24;
+
+    gdk_x11_display_error_trap_push(gdisplay);
+
+    cairo_surface_t *root_surface = cairo_xlib_surface_create(dpy,
+                                                              RootWindowOfScreen(xscreen),
+                                                              DefaultVisualOfScreen(xscreen),
+                                                              1, 1);
+    cairo_surface_t *surface = cairo_surface_create_similar(root_surface,
+                                                            cairo_surface_get_content(image),
+                                                            width, height);
+    cairo_surface_destroy(root_surface);
+
+    gboolean uploaded = FALSE;
+    if (cairo_surface_get_type(surface) == CAIRO_SURFACE_TYPE_XLIB && pixmap_format_matches_image(dpy, surface, depth)) {
+        XImage ximage = {
+            .width = width,
+            .height = height,
+            .xoffset = 0,
+            .format = ZPixmap,
+            .data = (char *)cairo_image_surface_get_data(image),
+            .byte_order = G_BYTE_ORDER == G_LITTLE_ENDIAN ? LSBFirst : MSBFirst,
+            .bitmap_unit = 32,
+            .bitmap_bit_order = G_BYTE_ORDER == G_LITTLE_ENDIAN ? LSBFirst : MSBFirst,
+            .bitmap_pad = 32,
+            .depth = depth,
+            .bytes_per_line = cairo_image_surface_get_stride(image),
+            .bits_per_pixel = 32,
+            .red_mask = 0xff0000,
+            .green_mask = 0x00ff00,
+            .blue_mask = 0x0000ff,
+        };
+
+        if (XInitImage(&ximage) != 0) {
+            Drawable pixmap = cairo_xlib_surface_get_drawable(surface);
+            GC gc = XCreateGC(dpy, pixmap, 0, NULL);
+            XPutImage(dpy, pixmap, gc, &ximage, 0, 0, 0, 0, width, height);
+            XFreeGC(dpy, gc);
+            uploaded = TRUE;
+        }
+    }
+
+    if (gdk_x11_display_error_trap_pop(gdisplay) != 0) {
+        uploaded = FALSE;
+    }
+
+    if (!uploaded) {
+        gdk_x11_display_error_trap_push(gdisplay);
+        cairo_surface_destroy(surface);
+        gdk_x11_display_error_trap_pop_ignored(gdisplay);
+        return cairo_surface_reference(image);
+    }
+
+    cairo_surface_mark_dirty(surface);
+    return surface;
+}
