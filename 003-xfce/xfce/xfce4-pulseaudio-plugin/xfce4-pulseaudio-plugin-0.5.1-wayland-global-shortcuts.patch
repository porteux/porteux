 static void
+pulseaudio_plugin_portal_update_keys (PulseaudioPlugin *pulseaudio_plugin)
+{
+  const gchar *keys[9];
+  guint        count = 0;
+
+  if (pulseaudio_config_get_enable_keyboard_shortcuts (pulseaudio_plugin->config))
+    {
+      keys[count++] = PULSEAUDIO_PLUGIN_RAISE_VOLUME_KEY;
+      keys[count++] = PULSEAUDIO_PLUGIN_LOWER_VOLUME_KEY;
+      keys[count++] = PULSEAUDIO_PLUGIN_MUTE_KEY;
+      keys[count++] = PULSEAUDIO_PLUGIN_MIC_MUTE_KEY;
+    }
+  if (pulseaudio_config_get_enable_multimedia_keys (pulseaudio_plugin->config))
+    {
+      keys[count++] = PULSEAUDIO_PLUGIN_PLAY_KEY;
+      keys[count++] = PULSEAUDIO_PLUGIN_STOP_KEY;
+      keys[count++] = PULSEAUDIO_PLUGIN_PREV_KEY;
+      keys[count++] = PULSEAUDIO_PLUGIN_NEXT_KEY;
+    }
+  keys[count] = NULL;
+  xfce_shortcuts_portal_set_keys (pulseaudio_plugin->portal, keys);
+}
