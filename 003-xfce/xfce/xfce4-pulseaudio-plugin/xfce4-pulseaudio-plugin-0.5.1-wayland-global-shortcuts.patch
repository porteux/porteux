+      || g_strcmp0 (key, PULSEAUDIO_PLUGIN_LOWER_VOLUME_KEY) == 0)
+    pulseaudio_plugin_volume_key_pressed (key, user_data);
+  else if (g_strcmp0 (key, PULSEAUDIO_PLUGIN_MUTE_KEY) == 0)
+    pulseaudio_plugin_mute_pressed (key, user_data);
+  else if (g_strcmp0 (key, PULSEAUDIO_PLUGIN_MIC_MUTE_KEY) == 0)
+    pulseaudio_plugin_mic_mute_pressed (key, user_data);
+  else if (g_strcmp0 (key, PULSEAUDIO_PLUGIN_PLAY_KEY) == 0)
+    pulseaudio_plugin_play_key_pressed (key, user_data);
+  else if (g_strcmp0 (key, PULSEAUDIO_PLUGIN_STOP_KEY) == 0)
+    pulseaudio_plugin_stop_key_pressed (key, user_data);
+  else if (g_strcmp0 (key, PULSEAUDIO_PLUGIN_PREV_KEY) == 0)
+    pulseaudio_plugin_prev_key_pressed (key, user_data);
+  else if (g_strcmp0 (key, PULSEAUDIO_PLUGIN_NEXT_KEY) == 0)
+    pulseaudio_plugin_next_key_pressed (key, user_data);
