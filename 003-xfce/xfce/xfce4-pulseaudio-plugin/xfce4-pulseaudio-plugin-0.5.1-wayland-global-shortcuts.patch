diff -ruN -x b xfce4-pulseaudio-plugin-0.5.1/panel-plugin/xfce-shortcuts-portal.c ../xfce4-pulseaudio-plugin-0.5.1/panel-plugin/xfce-shortcuts-portal.c
--- xfce4-pulseaudio-plugin-0.5.1/panel-plugin/xfce-shortcuts-portal.c	1970-01-01 01:00:00.000000000 +0100
+++ xfce4-pulseaudio-plugin-0.5.1/panel-plugin/xfce-shortcuts-portal.c	2026-11-06 13:44:47.125167100 +0100
@@ -0,0 +1,298 @@
+#include "xfce-shortcuts-portal.h"
+
+#include <gio/gio.h>
+
+#define PORTAL_BUS_NAME "org.freedesktop.portal.Desktop"
+#define PORTAL_PATH "/org/freedesktop/portal/desktop"
+#define SHORTCUTS_INTERFACE "org.freedesktop.portal.GlobalShortcuts"
+
+struct _XfceShortcutsPortal
+{
+  gchar                      *app_id;
+  XfceShortcutsPortalHandler  handler;
+  gpointer                    user_data;
+  GDBusConnection            *connection;
+  GCancellable               *cancellable;
+  gchar                     **keys;
+  gchar                      *session;
+  gboolean                    ready;
+  guint                       generation;
+  guint                       token;
+  guint                       activated_id;
+  guint                       response_id;
+};
+
+static void   on_connected        (GObject      *source,
+                                   GAsyncResult *result,
+                                   gpointer      data);
+static void   on_registered       (GObject      *source,
+                                   GAsyncResult *result,
+                                   gpointer      data);
+static void   on_activated        (GDBusConnection *connection,
+                                   const gchar     *sender,
+                                   const gchar     *path,
+                                   const gchar     *interface,
+                                   const gchar     *signal,
+                                   GVariant        *parameters,
+                                   gpointer         data);
+static void   on_response         (GDBusConnection *connection,
+                                   const gchar     *sender,
+                                   const gchar     *path,
+                                   const gchar     *interface,
+                                   const gchar     *signal,
+                                   GVariant        *parameters,
+                                   gpointer         data);
+static void   start_session       (XfceShortcutsPortal *portal);
+static void   close_session       (XfceShortcutsPortal *portal);
+static void   bind_keys           (XfceShortcutsPortal *portal);
+static gchar *next_token          (XfceShortcutsPortal *portal);
+static void   watch_response      (XfceShortcutsPortal *portal,
+                                   const gchar         *token);
+static void   stop_watching       (XfceShortcutsPortal *portal);
+
+XfceShortcutsPortal *
+xfce_shortcuts_portal_new (const gchar                *app_id,
+                           XfceShortcutsPortalHandler  handler,
+                           gpointer                    user_data)
+{
+  XfceShortcutsPortal *portal = g_new0 (XfceShortcutsPortal, 1);
+  gchar               *address;
+
+  portal->app_id = g_strdup (app_id);
+  portal->handler = handler;
+  portal->user_data = user_data;
+  portal->cancellable = g_cancellable_new ();
+  address = g_dbus_address_get_for_bus_sync (G_BUS_TYPE_SESSION, NULL, NULL);
+  if (address != NULL)
+    g_dbus_connection_new_for_address (address,
+                                       G_DBUS_CONNECTION_FLAGS_AUTHENTICATION_CLIENT
+                                       | G_DBUS_CONNECTION_FLAGS_MESSAGE_BUS_CONNECTION,
+                                       NULL, portal->cancellable, on_connected, portal);
+  g_free (address);
+  return portal;
+}
+
+void
+xfce_shortcuts_portal_set_keys (XfceShortcutsPortal *portal,
+                                const gchar * const *keys)
+{
+  g_strfreev (portal->keys);
+  portal->keys = g_strdupv ((gchar **) keys);
+  portal->generation++;
+  if (!portal->ready)
+    return;
+  close_session (portal);
+  if (portal->keys != NULL && portal->keys[0] != NULL)
+    start_session (portal);
+}
+
+void
+xfce_shortcuts_portal_free (XfceShortcutsPortal *portal)
+{
+  if (portal == NULL)
+    return;
+  g_cancellable_cancel (portal->cancellable);
+  if (portal->connection != NULL)
+    {
+      close_session (portal);
+      if (portal->activated_id != 0)
+        g_dbus_connection_signal_unsubscribe (portal->connection, portal->activated_id);
+      g_dbus_connection_flush_sync (portal->connection, NULL, NULL);
+      g_object_unref (portal->connection);
+    }
+  g_object_unref (portal->cancellable);
+  g_strfreev (portal->keys);
+  g_free (portal->app_id);
+  g_free (portal);
+}
+
+static void
+on_connected (GObject      *source,
+              GAsyncResult *result,
+              gpointer      data)
+{
+  XfceShortcutsPortal *portal = data;
+  GDBusConnection     *connection;
+
+  (void) source;
+  connection = g_dbus_connection_new_for_address_finish (result, NULL);
+  if (connection == NULL)
+    return;
+  portal->connection = connection;
+  portal->activated_id = g_dbus_connection_signal_subscribe (connection, PORTAL_BUS_NAME,
+                                                             SHORTCUTS_INTERFACE, "Activated",
+                                                             PORTAL_PATH, NULL,
+                                                             G_DBUS_SIGNAL_FLAGS_NONE,
+                                                             on_activated, portal, NULL);
+  g_dbus_connection_call (connection, PORTAL_BUS_NAME, PORTAL_PATH,
+                          "org.freedesktop.host.portal.Registry", "Register",
+                          g_variant_new ("(s@a{sv})", portal->app_id,
+                                         g_variant_new_array (G_VARIANT_TYPE ("{sv}"), NULL, 0)),
+                          NULL, G_DBUS_CALL_FLAGS_NONE, -1, portal->cancellable,
+                          on_registered, portal);
+}
+
+static void
+on_registered (GObject      *source,
+               GAsyncResult *result,
+               gpointer      data)
+{
+  XfceShortcutsPortal *portal = data;
+  GVariant            *reply;
+
+  reply = g_dbus_connection_call_finish (G_DBUS_CONNECTION (source), result, NULL);
+  if (reply != NULL)
+    g_variant_unref (reply);
+  if (g_cancellable_is_cancelled (portal->cancellable))
+    return;
+  portal->ready = TRUE;
+  if (portal->keys != NULL && portal->keys[0] != NULL)
+    start_session (portal);
+}
+
+static void
+on_activated (GDBusConnection *connection,
+              const gchar     *sender,
+              const gchar     *path,
+              const gchar     *interface,
+              const gchar     *signal,
+              GVariant        *parameters,
+              gpointer         data)
+{
+  XfceShortcutsPortal *portal = data;
+  const gchar         *session;
+  const gchar         *key;
+
+  (void) connection;
+  (void) sender;
+  (void) path;
+  (void) interface;
+  (void) signal;
+  g_variant_get (parameters, "(&o&st@a{sv})", &session, &key, NULL, NULL);
+  if (g_strcmp0 (session, portal->session) == 0)
+    portal->handler (key, portal->user_data);
+}
+
+static void
+on_response (GDBusConnection *connection,
+             const gchar     *sender,
+             const gchar     *path,
+             const gchar     *interface,
+             const gchar     *signal,
+             GVariant        *parameters,
+             gpointer         data)
+{
+  XfceShortcutsPortal *portal = data;
+  guint32              response;
+  GVariant            *results;
+  const gchar         *session = NULL;
+
+  (void) connection;
+  (void) sender;
+  (void) path;
+  (void) interface;
+  (void) signal;
+  stop_watching (portal);
+  g_variant_get (parameters, "(u@a{sv})", &response, &results);
+  if (response == 0 && portal->session == NULL
+      && g_variant_lookup (results, "session_handle", "&s", &session))
+    {
+      portal->session = g_strdup (session);
+      bind_keys (portal);
+    }
+  g_variant_unref (results);
+}
+
+static void
+start_session (XfceShortcutsPortal *portal)
+{
+  GVariantBuilder  options;
+  gchar           *token = next_token (portal);
+  gchar           *session_token = next_token (portal);
+
+  watch_response (portal, token);
+  g_variant_builder_init (&options, G_VARIANT_TYPE_VARDICT);
+  g_variant_builder_add (&options, "{sv}", "handle_token", g_variant_new_string (token));
+  g_variant_builder_add (&options, "{sv}", "session_handle_token",
+                         g_variant_new_string (session_token));
+  g_dbus_connection_call (portal->connection, PORTAL_BUS_NAME, PORTAL_PATH,
+                          SHORTCUTS_INTERFACE, "CreateSession",
+                          g_variant_new ("(a{sv})", &options), NULL,
+                          G_DBUS_CALL_FLAGS_NONE, -1, portal->cancellable, NULL, NULL);
+  g_free (token);
+  g_free (session_token);
+}
+
+static void
+close_session (XfceShortcutsPortal *portal)
+{
+  stop_watching (portal);
+  if (portal->session == NULL)
+    return;
+  g_dbus_connection_call (portal->connection, PORTAL_BUS_NAME, portal->session,
+                          "org.freedesktop.portal.Session", "Close", NULL, NULL,
+                          G_DBUS_CALL_FLAGS_NONE, -1, NULL, NULL, NULL);
+  g_clear_pointer (&portal->session, g_free);
+}
+
+static void
+bind_keys (XfceShortcutsPortal *portal)
+{
+  GVariantBuilder  shortcuts;
+  GVariantBuilder  options;
+  gchar           *token = next_token (portal);
+
+  g_variant_builder_init (&shortcuts, G_VARIANT_TYPE ("a(sa{sv})"));
+  for (guint i = 0; portal->keys != NULL && portal->keys[i] != NULL; i++)
+    {
+      GVariantBuilder properties;
+
+      g_variant_builder_init (&properties, G_VARIANT_TYPE_VARDICT);
+      g_variant_builder_add (&properties, "{sv}", "description",
+                             g_variant_new_string (portal->keys[i]));
+      g_variant_builder_add (&properties, "{sv}", "preferred_trigger",
+                             g_variant_new_string (portal->keys[i]));
+      g_variant_builder_add (&shortcuts, "(sa{sv})", portal->keys[i], &properties);
+    }
+  g_variant_builder_init (&options, G_VARIANT_TYPE_VARDICT);
+  g_variant_builder_add (&options, "{sv}", "handle_token", g_variant_new_string (token));
+  g_dbus_connection_call (portal->connection, PORTAL_BUS_NAME, PORTAL_PATH,
+                          SHORTCUTS_INTERFACE, "BindShortcuts",
+                          g_variant_new ("(oa(sa{sv})sa{sv})", portal->session, &shortcuts, "",
+                                         &options),
+                          NULL, G_DBUS_CALL_FLAGS_NONE, -1, portal->cancellable, NULL, NULL);
+  g_free (token);
+}
+
+static gchar *
+next_token (XfceShortcutsPortal *portal)
+{
+  return g_strdup_printf ("xfce%u_%u", portal->generation, ++portal->token);
+}
+
+static void
+watch_response (XfceShortcutsPortal *portal,
+                const gchar         *token)
+{
+  gchar *sender = g_strdup (g_dbus_connection_get_unique_name (portal->connection) + 1);
+  gchar *path;
+
+  g_strdelimit (sender, ".", '_');
+  path = g_strdup_printf (PORTAL_PATH "/request/%s/%s", sender, token);
+  stop_watching (portal);
+  portal->response_id = g_dbus_connection_signal_subscribe (portal->connection, PORTAL_BUS_NAME,
+                                                            "org.freedesktop.portal.Request",
+                                                            "Response", path, NULL,
+                                                            G_DBUS_SIGNAL_FLAGS_NONE,
+                                                            on_response, portal, NULL);
+  g_free (path);
+  g_free (sender);
+}
+
+static void
+stop_watching (XfceShortcutsPortal *portal)
+{
+  if (portal->response_id != 0)
+    g_dbus_connection_signal_unsubscribe (portal->connection, portal->response_id);
+  portal->response_id = 0;
+}
diff -ruN -x b xfce4-pulseaudio-plugin-0.5.1/panel-plugin/xfce-shortcuts-portal.h ../xfce4-pulseaudio-plugin-0.5.1/panel-plugin/xfce-shortcuts-portal.h
--- xfce4-pulseaudio-plugin-0.5.1/panel-plugin/xfce-shortcuts-portal.h	1970-01-01 01:00:00.000000000 +0100
