@@ -72,7 +80,8 @@ thunar_compact_view_class_init (ThunarCompactViewClass *klass)
 static void
 thunar_compact_view_init (ThunarCompactView *compact_view)
 {
-  gboolean max_chars;
+  GtkWidget *view;
+  gboolean   max_chars;
 
   /* initialize the icon view properties */
   xfce_icon_view_set_margin (XFCE_ICON_VIEW (gtk_bin_get_child (GTK_BIN (compact_view))), 3);
@@ -94,10 +103,63 @@ thunar_compact_view_init (ThunarCompactView *compact_view)
 
   /* setup ellipsization */
   if (max_chars > 0)
-    g_object_set (G_OBJECT (THUNAR_STANDARD_VIEW (compact_view)->name_renderer),
-                  "ellipsize", PANGO_ELLIPSIZE_MIDDLE,
-                  "width-chars", max_chars,
-                  NULL);
+    {
+      g_object_set (G_OBJECT (THUNAR_STANDARD_VIEW (compact_view)->name_renderer),
+                    "ellipsize", PANGO_ELLIPSIZE_MIDDLE,
+                    "width-chars", max_chars,
+                    NULL);
+
+      view = gtk_bin_get_child (GTK_BIN (compact_view));
+      g_signal_connect (G_OBJECT (view), "query-tooltip", G_CALLBACK (thunar_compact_view_query_tooltip), compact_view);
+      gtk_widget_set_has_tooltip (view, TRUE);
+    }
+}
+
+
+
+static gboolean
+thunar_compact_view_query_tooltip (GtkWidget         *view,
+                                   gint               x,
+                                   gint               y,
+                                   gboolean           keyboard_mode,
+                                   GtkTooltip        *tooltip,
+                                   ThunarCompactView *compact_view)
+{
+  GtkCellRenderer *renderer = THUNAR_STANDARD_VIEW (compact_view)->name_renderer;
+  GtkTreeModel    *model;
+  GtkTreePath     *path;
+  GtkTreeIter      iter;
+  GdkRectangle     cell_area;
+  GdkRectangle     item_area;
+  gboolean         show = FALSE;
+  gchar           *name = NULL;
+
+  if (keyboard_mode)
+    return FALSE;
+
+  path = xfce_icon_view_get_path_at_pos (XFCE_ICON_VIEW (view), x, y);
+  if (path == NULL)
+    return FALSE;
+
+  model = xfce_icon_view_get_model (XFCE_ICON_VIEW (view));
+  if (gtk_tree_model_get_iter (model, &iter, path)
+      && xfce_icon_view_get_cell_area (XFCE_ICON_VIEW (view), path, renderer, &cell_area)
+      && xfce_icon_view_get_cell_area (XFCE_ICON_VIEW (view), path, NULL, &item_area))
+    {
+      gtk_tree_model_get (model, &iter, THUNAR_COLUMN_NAME, &name, -1);
+      if (name != NULL && thunar_text_renderer_is_ellipsized (renderer, view, name, cell_area.width))
+        {
+          xfce_icon_view_icon_to_widget_coords (XFCE_ICON_VIEW (view), item_area.x, item_area.y, &item_area.x, &item_area.y);
+          gtk_tooltip_set_tip_area (tooltip, &item_area);
+          gtk_tooltip_set_text (tooltip, name);
+          show = TRUE;
+        }
+      g_free (name);
+    }
+
+  gtk_tree_path_free (path);
+
+  return show;
 }
 
 
