Accept image drops from Chromium-based browsers on Wayland, which offer the
image only as application/octet-stream;name="<file>", and save it under that name.

diff --git a/thunar/thunar-dnd.c b/thunar/thunar-dnd.c
index 6ed112d..d60211f 100644
--- a/thunar/thunar-dnd.c
+++ b/thunar/thunar-dnd.c
@@ -281,3 +281,26 @@ thunar_dnd_perform (GtkWidget    *widget,
 
   return succeed;
 }
+
+
+
+gchar *
+thunar_dnd_get_octet_stream_name (GdkAtom target)
+{
+  static const gchar prefix[] = "application/octet-stream;name=\"";
+  gchar             *type = gdk_atom_name (target);
+  gchar             *name = NULL;
+  gsize              length = strlen (type);
+
+  if (length > sizeof (prefix) && g_str_has_prefix (type, prefix) && type[length - 1] == '"')
+    {
+      type[length - 1] = '\0';
+      name = g_strcompress (type + sizeof (prefix) - 1);
+    }
+  g_free (type);
+
+  if (name != NULL && (strchr (name, G_DIR_SEPARATOR) != NULL || strcmp (name, ".") == 0 || strcmp (name, "..") == 0))
+    g_clear_pointer (&name, g_free);
+
+  return name;
+}
