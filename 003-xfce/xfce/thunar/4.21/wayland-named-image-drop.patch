+static GdkAtom
+thunar_standard_view_find_drop_target (GtkWidget          *view,
+                                       GdkDragContext     *context,
+                                       ThunarStandardView *standard_view)
+{
+  GtkTargetList *targets;
+  GdkAtom        target;
+  GdkAtom        named;
+  GList         *lp;
+  gchar         *filename;
+
+  target = gtk_drag_dest_find_target (view, context, NULL);
+  if (target != GDK_NONE && target != gdk_atom_intern_static_string ("application/octet-stream"))
+    return target;
+
+  for (lp = gdk_drag_context_list_targets (context); lp != NULL; lp = lp->next)
+    {
+      named = GDK_POINTER_TO_ATOM (lp->data);
+      filename = thunar_standard_view_named_octet_stream (named);
+      if (filename == NULL)
+        continue;
+      g_free (filename);
+
+      targets = gtk_drag_dest_get_target_list (view);
+      gtk_target_list_remove (targets, standard_view->priv->drop_named_target);
+      gtk_target_list_add (targets, named, 0, TARGET_APPLICATION_OCTET_STREAM);
+      standard_view->priv->drop_named_target = named;
+      return named;
+    }
+
+  return target;
+}
