+static GdkAtom
+thunar_standard_view_find_drop_target (GtkWidget          *view,
+                                       GdkDragContext     *context,
+                                       ThunarStandardView *standard_view)
+{
+  GtkTargetList *targets;
+  GdkAtom        target;
+  gchar         *name;
+
+  target = gtk_drag_dest_find_target (view, context, NULL);
+  if (target != GDK_NONE && target != gdk_atom_intern_static_string ("application/octet-stream"))
+    return target;
+
+  for (GList *lp = gdk_drag_context_list_targets (context); lp != NULL; lp = lp->next)
+    {
+      name = thunar_dnd_get_octet_stream_name (GDK_POINTER_TO_ATOM (lp->data));
+      if (name == NULL)
+        continue;
+      g_free (name);
+
+      targets = gtk_drag_dest_get_target_list (view);
+      gtk_target_list_remove (targets, standard_view->priv->drop_named_target);
+      gtk_target_list_add (targets, GDK_POINTER_TO_ATOM (lp->data), 0, TARGET_APPLICATION_OCTET_STREAM);
+      standard_view->priv->drop_named_target = GDK_POINTER_TO_ATOM (lp->data);
+      return standard_view->priv->drop_named_target;
+    }
+
+  return target;
+}
