+static const gchar *
+thunar_standard_view_skip_spaces (const gchar *p)
+{
+  while (*p == ' ' || *p == '\t')
+    p++;
+  return p;
+}
+
+
+
+static gchar *
+thunar_standard_view_read_param_value (const gchar **cursor)
+{
+  const gchar *p = *cursor;
+  GString     *value = g_string_new (NULL);
+
+  if (*p == '"')
+    {
+      for (p++; *p != '\0' && *p != '"'; p++)
+        {
+          if (*p == '\\' && p[1] != '\0')
+            p++;
+          g_string_append_c (value, *p);
+        }
+      if (*p == '"')
+        p++;
+    }
+  else
+    {
+      for (; *p != '\0' && *p != ';' && *p != ' ' && *p != '\t'; p++)
+        g_string_append_c (value, *p);
+    }
+
+  *cursor = p;
+  return g_string_free (value, FALSE);
+}
+
+
+
+static gchar *
+thunar_standard_view_named_octet_stream (GdkAtom target)
+{
+  static const gchar base[] = "application/octet-stream";
+  gchar             *type;
+  gchar             *filename = NULL;
+  gchar             *value;
+  const gchar       *p;
+  const gchar       *key;
+  gsize              key_length;
+
+  type = gdk_atom_name (target);
+  if (type != NULL && g_ascii_strncasecmp (type, base, strlen (base)) == 0)
+    {
+      p = thunar_standard_view_skip_spaces (type + strlen (base));
+      while (filename == NULL && *p == ';')
+        {
+          key = thunar_standard_view_skip_spaces (p + 1);
+          for (p = key; *p != '\0' && *p != '=' && *p != ';' && *p != ' ' && *p != '\t'; p++)
+            ;
+          key_length = p - key;
+          p = thunar_standard_view_skip_spaces (p);
+          if (*p != '=')
+            continue;
+          p = thunar_standard_view_skip_spaces (p + 1);
+          value = thunar_standard_view_read_param_value (&p);
+          if (key_length == 4 && g_ascii_strncasecmp (key, "name", 4) == 0)
+            filename = value;
+          else
+            g_free (value);
+          p = thunar_standard_view_skip_spaces (p);
+        }
+    }
+  g_free (type);
+
+  if (filename != NULL
+      && (*filename == '\0' || strchr (filename, G_DIR_SEPARATOR) != NULL
+          || strcmp (filename, ".") == 0 || strcmp (filename, "..") == 0))
+    {
+      g_free (filename);
+      filename = NULL;
+    }
+
+  return filename;
+}
