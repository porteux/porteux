@@ -1338,4 +1348,55 @@ thunar_details_view_row_changed (GtkTreeView       *tree_view,
 
 
+static gboolean
+thunar_details_view_query_tooltip (GtkWidget         *tree_view,
+                                   gint               x,
+                                   gint               y,
+                                   gboolean           keyboard_mode,
+                                   GtkTooltip        *tooltip,
+                                   ThunarDetailsView *details_view)
+{
+  GtkCellRenderer   *renderer = THUNAR_STANDARD_VIEW (details_view)->name_renderer;
+  GtkTreeViewColumn *column = details_view->columns[THUNAR_COLUMN_NAME];
+  GtkTreeViewColumn *column_at_pos;
+  GtkTreeModel      *model;
+  GtkTreePath       *path;
+  GtkTreeIter        iter;
+  GdkRectangle       cell_area;
+  GdkRectangle       background_area;
+  gboolean           show = FALSE;
+  gchar             *name = NULL;
+  gint               width;
+
+  if (keyboard_mode)
+    return FALSE;
+
+  if (!gtk_tree_view_get_tooltip_context (GTK_TREE_VIEW (tree_view), &x, &y, FALSE, &model, &path, &iter))
+    return FALSE;
+
+  if (gtk_tree_view_get_path_at_pos (GTK_TREE_VIEW (tree_view), x, y, NULL, &column_at_pos, NULL, NULL)
+      && column_at_pos == column
+      && gtk_tree_view_column_cell_get_position (column, renderer, NULL, &width))
+    {
+      gtk_tree_view_get_cell_area (GTK_TREE_VIEW (tree_view), path, column, &cell_area);
+      gtk_tree_view_get_background_area (GTK_TREE_VIEW (tree_view), NULL, column, &background_area);
+      width -= background_area.width - cell_area.width;
+
+      gtk_tree_model_get (model, &iter, THUNAR_COLUMN_NAME, &name, -1);
+      if (name != NULL && thunar_text_renderer_is_ellipsized (renderer, tree_view, name, width))
+        {
+          gtk_tooltip_set_text (tooltip, name);
+          gtk_tree_view_set_tooltip_cell (GTK_TREE_VIEW (tree_view), tooltip, path, column, NULL);
+          show = TRUE;
+        }
+      g_free (name);
+    }
+
+  gtk_tree_path_free (path);
+
+  return show;
+}
+
+
