diff --git a/thunar/thunar-text-renderer.c b/thunar/thunar-text-renderer.c
index 3a9d43b..f2d197a 100644
--- a/thunar/thunar-text-renderer.c
+++ b/thunar/thunar-text-renderer.c
@@ -256,2 +256,39 @@ thunar_text_renderer_render (GtkCellRenderer     *cell,
   ->default_render_function (cell, cr, widget, background_area, cell_area, flags);
 }
+
+
+
+gboolean
+thunar_text_renderer_is_ellipsized (GtkCellRenderer *renderer,
+                                    GtkWidget       *widget,
+                                    const gchar     *text,
+                                    gint             width)
+{
+  PangoEllipsizeMode ellipsize;
+  PangoAttrList     *renderer_attrs;
+  PangoAttrList     *attrs;
+  PangoLayout       *layout;
+  gboolean           ellipsized;
+  gdouble            scale;
+  gint               xpad;
+
+  g_object_get (G_OBJECT (renderer), "ellipsize", &ellipsize, NULL);
+  if (ellipsize == PANGO_ELLIPSIZE_NONE)
+    return FALSE;
+
+  g_object_get (G_OBJECT (renderer), "scale", &scale, "attributes", &renderer_attrs, NULL);
+  gtk_cell_renderer_get_padding (renderer, &xpad, NULL);
+
+  layout = gtk_widget_create_pango_layout (widget, text);
+  attrs = renderer_attrs != NULL ? pango_attr_list_copy (renderer_attrs) : pango_attr_list_new ();
+  g_clear_pointer (&renderer_attrs, pango_attr_list_unref);
+  pango_attr_list_insert (attrs, pango_attr_scale_new (scale));
+  pango_layout_set_attributes (layout, attrs);
+  pango_attr_list_unref (attrs);
+  pango_layout_set_ellipsize (layout, ellipsize);
+  pango_layout_set_width (layout, MAX (0, width - 2 * xpad) * PANGO_SCALE);
+  ellipsized = pango_layout_is_ellipsized (layout);
+  g_object_unref (G_OBJECT (layout));
+
+  return ellipsized;
+}
