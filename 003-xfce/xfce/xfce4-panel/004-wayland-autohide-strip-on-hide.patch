Show the auto-hide strip whenever the panel hides on Wayland

With auto-hide on Wayland, the panel could hide with no strip at the
screen edge, so hovering the edge never showed it again. The strip is only
placed in size_allocate, which waits for a frame callback, and compositors
don't send those to covered surfaces (e.g. under a fullscreen game). The
slide-out runs on a timer and hides the panel anyway.

- move the strip placement out of size_allocate into its own function
- autohide_ease_out: when size_allocate didn't run and the panel is
  hiding, show the strip too (not for floating panels)
- autohide_ease_out: with popdown-speed 0, don't animate (it divided by 0)
- size_allocate: when it comes late during the slide, update the strip
  to the new size

X11 is unchanged.

--- a/panel/panel-window.c
+++ b/panel/panel-window.c
@@ -1666,6 +1666,56 @@
 
 
 
+static void
+panel_window_autohide_strip_show (PanelWindow *window,
+                                  gint *x,
+                                  gint *y,
+                                  gint *w,
+                                  gint *h)
+{
+  /* set hidden window size */
+  *w = *h = window->autohide_size;
+
+  switch (window->snap_position)
+    {
+    /* left or right of the screen */
+    case SNAP_POSITION_E:
+    case SNAP_POSITION_EC:
+    case SNAP_POSITION_W:
+    case SNAP_POSITION_WC:
+      *h = window->alloc.height;
+      break;
+
+    /* top or bottom of the screen */
+    case SNAP_POSITION_NC:
+    case SNAP_POSITION_SC:
+    case SNAP_POSITION_N:
+    case SNAP_POSITION_S:
+      *w = window->alloc.width;
+      break;
+
+    /* corner or floating panel */
+    default:
+      if (IS_HORIZONTAL (window))
+        *w = window->alloc.width;
+      else
+        *h = window->alloc.height;
+      break;
+    }
+
+  /* position the autohide window */
+  if (gtk_layer_is_supported ())
+    gtk_widget_set_size_request (window->autohide_window, *w, *h);
+  else
+    gtk_window_resize (GTK_WINDOW (window->autohide_window), *w, *h);
+
+  panel_window_size_allocate_set_xy (window, *w, *h, x, y);
+  panel_window_move (window, GTK_WINDOW (window->autohide_window), *x, *y);
+  gtk_widget_show (window->autohide_window);
+}
