+++ b/lib/screenshooter-clipboard-wayland.c
@@ -0,0 +1,206 @@
+#include "screenshooter-clipboard-wayland.h"
+
+#include <signal.h>
+#include <string.h>
+
+#include <gdk/gdkwayland.h>
+#include <gio/gunixoutputstream.h>
+#include <protocols/wlr-data-control-unstable-v1-client.h>
+
+
+
+typedef struct {
+  struct zwlr_data_control_manager_v1 *manager;
+  struct zwlr_data_control_device_v1 *device;
+  struct zwlr_data_control_source_v1 *source;
+  GBytes *png;
+  GCallback released;
+  gpointer data;
+}
+ClipboardData;
+
+
+
+static ClipboardData *clipboard = NULL;
+
+
+
+static void
+handle_global (void *data, struct wl_registry *registry, uint32_t name, const char *interface, uint32_t version)
+{
+  struct zwlr_data_control_manager_v1 **manager = data;
+
+  if (g_strcmp0 (interface, zwlr_data_control_manager_v1_interface.name) == 0)
+    *manager = wl_registry_bind (registry, name, &zwlr_data_control_manager_v1_interface, 1);
+}
+
+
+
+static void
+handle_global_remove (void *data, struct wl_registry *registry, uint32_t name)
+{
+}
+
+
+
+static const struct wl_registry_listener registry_listener = {
+  .global = handle_global,
+  .global_remove = handle_global_remove
+};
+
+
+
+static void
+cb_write_done (GObject      *stream,
+               GAsyncResult *result,
+               gpointer      png)
+{
+  g_output_stream_write_all_finish (G_OUTPUT_STREAM (stream), result, NULL, NULL);
+  g_object_unref (stream);
+  g_bytes_unref (png);
+}
+
+
+
+static void
+handle_source_send (void *data, struct zwlr_data_control_source_v1 *source, const char *mime_type, int32_t fd)
+{
+  ClipboardData *self = data;
+  GOutputStream *stream = g_unix_output_stream_new (fd, TRUE);
+  gsize size;
+  gconstpointer bytes = g_bytes_get_data (self->png, &size);
+
+  g_output_stream_write_all_async (stream, bytes, size, G_PRIORITY_DEFAULT, NULL,
+                                   cb_write_done, g_bytes_ref (self->png));
+}
+
+
+
+static void
+screenshooter_wayland_clipboard_free (ClipboardData *self)
+{
+  zwlr_data_control_source_v1_destroy (self->source);
+  zwlr_data_control_device_v1_destroy (self->device);
+  zwlr_data_control_manager_v1_destroy (self->manager);
+  g_bytes_unref (self->png);
+  g_free (self);
+}
+
+
+
+static void
+handle_source_cancelled (void *data, struct zwlr_data_control_source_v1 *source)
+{
+  ClipboardData *self = data;
+  GCallback released = self->released;
+  gpointer released_data = self->data;
+
+  if (clipboard == self)
+    clipboard = NULL;
+  screenshooter_wayland_clipboard_free (self);
+  if (released != NULL)
+    ((void (*) (gpointer)) released) (released_data);
+}
+
+
+
+static const struct zwlr_data_control_source_v1_listener source_listener = {
+  .send = handle_source_send,
+  .cancelled = handle_source_cancelled
+};
+
+
+
+static void
+handle_device_data_offer (void *data, struct zwlr_data_control_device_v1 *device, struct zwlr_data_control_offer_v1 *offer)
+{
+}
+
+
+
+static void
+handle_device_selection (void *data, struct zwlr_data_control_device_v1 *device, struct zwlr_data_control_offer_v1 *offer)
+{
+  if (offer != NULL)
+    zwlr_data_control_offer_v1_destroy (offer);
+}
+
+
+
+static void
+handle_device_finished (void *data, struct zwlr_data_control_device_v1 *device)
+{
+}
+
+
+
+static const struct zwlr_data_control_device_v1_listener device_listener = {
+  .data_offer = handle_device_data_offer,
+  .selection = handle_device_selection,
+  .finished = handle_device_finished,
+  .primary_selection = handle_device_selection
+};
+
+
+
+static struct zwlr_data_control_manager_v1
+*screenshooter_wayland_clipboard_bind (struct wl_display *display)
+{
+  struct zwlr_data_control_manager_v1 *manager = NULL;
+  struct wl_registry *registry = wl_display_get_registry (display);
+
+  wl_registry_add_listener (registry, &registry_listener, &manager);
+  wl_display_roundtrip (display);
+  wl_registry_destroy (registry);
+
+  return manager;
+}
+
+
+
+gboolean
+screenshooter_wayland_clipboard_set (GdkPixbuf *screenshot,
+                                     GCallback  released,
+                                     gpointer   data)
+{
+  GdkDisplay *gdk_display = gdk_display_get_default ();
+  struct wl_display *display = gdk_wayland_display_get_wl_display (gdk_display);
+  struct wl_seat *seat = gdk_wayland_seat_get_wl_seat (gdk_display_get_default_seat (gdk_display));
+  struct zwlr_data_control_manager_v1 *manager = screenshooter_wayland_clipboard_bind (display);
+  ClipboardData *self;
+  gchar *png;
+  gsize png_size;
+
+  if (manager == NULL)
+    return FALSE;
+
+  if (!gdk_pixbuf_save_to_buffer (screenshot, &png, &png_size, "png", NULL, NULL))
+    {
+      zwlr_data_control_manager_v1_destroy (manager);
+      return FALSE;
+    }
+
+  signal (SIGPIPE, SIG_IGN);
+
+  if (clipboard != NULL)
+    {
+      clipboard->released = NULL;
+      screenshooter_wayland_clipboard_free (clipboard);
+    }
+
+  self = g_new0 (ClipboardData, 1);
+  self->manager = manager;
+  self->png = g_bytes_new_take (png, png_size);
+  self->released = released;
+  self->data = data;
+  self->source = zwlr_data_control_manager_v1_create_data_source (manager);
+  zwlr_data_control_source_v1_add_listener (self->source, &source_listener, self);
+  zwlr_data_control_source_v1_offer (self->source, "image/png");
+  self->device = zwlr_data_control_manager_v1_get_data_device (manager, seat);
+  zwlr_data_control_device_v1_add_listener (self->device, &device_listener, self);
+  zwlr_data_control_device_v1_set_selection (self->device, self->source);
+  wl_display_flush (display);
+  clipboard = self;
+
+  return TRUE;
+}
