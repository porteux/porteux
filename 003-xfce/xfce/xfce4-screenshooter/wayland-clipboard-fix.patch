+gboolean
+screenshooter_wayland_can_capture_window (void)
+{
+  static gint supported = -1;
+
+  if (supported == -1)
+    {
+      guint found = 0;
+      struct wl_display *display = gdk_wayland_display_get_wl_display (gdk_display_get_default ());
+      struct wl_registry *registry = wl_display_get_registry (display);
+
+      wl_registry_add_listener (registry, &registry_check_listener, &found);
+      wl_display_roundtrip (display);
+      wl_registry_destroy (registry);
+      supported = found == 4;
+    }
+
+  return supported;
+}
