+static ToplevelData
+*screenshooter_find_active_window (ClientData *client_data)
+{
+  ToplevelData *active = NULL;
+  guint twins_before = 0;
+
+  for (guint i = 0; i < client_data->wlr_toplevels->len && active == NULL; i++)
+    {
+      ToplevelData *toplevel = g_ptr_array_index (client_data->wlr_toplevels, i);
+      if (toplevel->activated)
+        active = toplevel;
+    }
+  if (active == NULL)
+    return NULL;
+
+  for (guint i = 0; g_ptr_array_index (client_data->wlr_toplevels, i) != active; i++)
+    {
+      if (screenshooter_same_toplevel (g_ptr_array_index (client_data->wlr_toplevels, i), active))
+        twins_before++;
+    }
+
+  for (guint i = 0; i < client_data->ext_toplevels->len; i++)
+    {
+      ToplevelData *toplevel = g_ptr_array_index (client_data->ext_toplevels, i);
+      if (!screenshooter_same_toplevel (toplevel, active))
+        continue;
+      if (twins_before == 0)
+        return toplevel;
+      twins_before--;
+    }
+
+  return NULL;
+}
+
+
+
+static GdkPixbuf
+*screenshooter_capture_active_window (gboolean show_mouse)
+{
+  ClientData client_data = {};
+  OutputData *output;
+  ToplevelData *window;
+  GdkPixbuf *screenshot = NULL;
+  guint options = show_mouse ? EXT_IMAGE_COPY_CAPTURE_MANAGER_V1_OPTIONS_PAINT_CURSORS : 0;
+  struct ext_image_capture_source_v1 *source;
+
+  client_data.wlr_toplevels = g_ptr_array_new_with_free_func (screenshooter_free_wlr_toplevel);
+  client_data.ext_toplevels = g_ptr_array_new_with_free_func (screenshooter_free_ext_toplevel);
+
+  if (!screenshooter_initialize_client_data (&client_data))
+    {
+      screenshooter_free_client_data (&client_data);
+      return NULL;
+    }
+
+  wl_display_roundtrip (client_data.display);
+  wl_display_roundtrip (client_data.display);
+
+  window = screenshooter_find_active_window (&client_data);
+  if (window == NULL || client_data.toplevel_capture_manager == NULL || client_data.image_copy_capture_manager == NULL)
+    {
+      screenshooter_free_client_data (&client_data);
+      return screenshooter_capture_fullscreen (show_mouse, NULL, NULL);
+    }
+
+  output = g_new0 (OutputData, 1);
+  output->client_data = &client_data;
+
+  source = ext_foreign_toplevel_image_capture_source_manager_v1_create_source (client_data.toplevel_capture_manager, window->handle);
+  output->image_copy_capture_session = ext_image_copy_capture_manager_v1_create_session (client_data.image_copy_capture_manager, source, options);
+  ext_image_copy_capture_session_v1_add_listener (output->image_copy_capture_session, &image_copy_capture_session_listener, output);
+  ext_image_capture_source_v1_destroy (source);
+
+  while (!output->capture_done && !output->capture_failed)
+    {
+      if (wl_display_dispatch (client_data.display) == -1)
+        output->capture_failed = TRUE;
+    }
+
+  if (output->capture_failed)
+    screenshooter_error (_("Failed to capture"));
+  else
+    {
+      GdkPixbuf *pixbuf = screenshooter_convert_buffer_to_pixbuf (output);
+      if (pixbuf != NULL)
+        {
+          screenshot = gdk_pixbuf_copy (pixbuf);
+          g_object_unref (pixbuf);
+        }
+    }
+
+  screenshooter_free_output_data (output);
+  screenshooter_free_client_data (&client_data);
+
+  return screenshot;
+}
