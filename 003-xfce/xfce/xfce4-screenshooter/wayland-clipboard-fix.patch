 /* Internals */
 
 
 
+static gboolean clipboard_held = FALSE;
+static GMainLoop *clipboard_loop = NULL;
+
+
+
+static void
+cb_clipboard_get (GtkClipboard     *clipboard,
+                  GtkSelectionData *selection_data,
+                  guint             info,
+                  gpointer          owner)
+{
+  gtk_selection_data_set_pixbuf (selection_data, GDK_PIXBUF (owner));
+}
+
+
+
+static void
+cb_clipboard_released (gpointer data)
+{
+  clipboard_held = FALSE;
+  if (clipboard_loop != NULL)
+    g_main_loop_quit (clipboard_loop);
+}
+
+
+
+static void
+cb_clipboard_clear (GtkClipboard *clipboard,
+                    gpointer      owner)
+{
+  g_object_unref (owner);
+  cb_clipboard_released (NULL);
+}
+
+
+
+static void
+screenshooter_hold_clipboard (GtkClipboard *clipboard,
+                              GdkPixbuf    *screenshot)
+{
+  GtkTargetList *list = gtk_target_list_new (NULL, 0);
+  GtkTargetEntry *targets;
+  gint n_targets;
+
+  gtk_target_list_add_image_targets (list, 0, TRUE);
+  targets = gtk_target_table_new_from_list (list, &n_targets);
+  if (gtk_clipboard_set_with_owner (clipboard, targets, n_targets,
+                                    cb_clipboard_get, cb_clipboard_clear,
+                                    G_OBJECT (g_object_ref (screenshot))))
+    clipboard_held = TRUE;
+  else
+    g_object_unref (screenshot);
+  gtk_target_table_free (targets, n_targets);
+  gtk_target_list_unref (list);
+}
