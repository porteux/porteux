diff --git src/compositor.c src/compositor.c
index 3fe93cc..376b3aa 100644
--- src/compositor.c
+++ src/compositor.c
@@ -54,6 +54,7 @@
 #include "display.h"
 #include "screen.h"
 #include "client.h"
+#include "focus.h"
 #include "frame.h"
 #include "hints.h"
 #include "compositor.h"
@@ -5235,6 +5236,51 @@ compositorActivateScreen (ScreenInfo *screen_info, gboolean active)
 #endif /* HAVE_COMPOSITOR */
 }
 
+void
+compositorUpdateFullscreenSuspend (ScreenInfo *screen_info)
+{
+#ifdef HAVE_COMPOSITOR
+    DisplayInfo *display_info;
+    ScreenInfo *screen;
+    Client *c;
+    GSList *list;
+    gboolean active;
+
+    g_return_if_fail (screen_info != NULL);
+    TRACE ("entering");
+
+    display_info = screen_info->display_info;
+    c = clientGetFocus ();
+    for (list = display_info->screens; list; list = g_slist_next (list))
+    {
+        screen = (ScreenInfo *) list->data;
+        gboolean suspend;
+
+        suspend = screen->params->suspend_compositing_fullscreen &&
+                  (c != NULL) && (c->screen_info == screen) &&
+                  FLAG_TEST (c->flags, CLIENT_FLAG_FULLSCREEN);
+
+        if (suspend)
+        {
+            CWindow *cw = find_cwindow_in_screen (screen, c->frame);
+
+            /*
+             * _NET_WM_BYPASS_COMPOSITOR of 2 means the window wants compositing
+             * kept whatever happens. Anything relying on the compositor to
+             * present without tearing, a video player for one, can say so.
+             */
+            if ((cw != NULL) && (cw->bypass_compositor == 2))
+            {
+                suspend = FALSE;
+            }
+        }
+
+        active = screen->params->use_compositing && !suspend;
+        compositorActivateScreen (screen, active);
+    }
+#endif /* HAVE_COMPOSITOR */
+}
