Clear the primary monitor when the compositor says so

Bind xfce_output_manager_private_v1 version 2 and handle its new
xfce_output_v1.not_primary event, so a monitor stops being primary even
when no other monitor becomes primary.

--- a/libxfce4windowing/xfw-monitor-wayland.c
+++ b/libxfce4windowing/xfw-monitor-wayland.c
@@ -733,6 +733,16 @@
 }
 
 static void
+xfce_output_not_primary(void *data, struct xfce_output_v1 *xfce_output) {
+    g_debug("xfce output not_primary for ID %d", wl_proxy_get_id((struct wl_proxy *)xfce_output));
+    XfwMonitorManagerWayland *monitor_manager = data;
+    XfwMonitor *monitor = g_hash_table_lookup(monitor_manager->xfce_outputs_to_monitors, xfce_output);
+    if (monitor_manager->primary_monitor == monitor) {
+        monitor_manager->primary_monitor = NULL;
+    }
+}
+
+static void
 xfce_output_workarea(void *data, struct xfce_output_v1 *xfce_output, int32_t x, int32_t y, uint32_t width, uint32_t height) {
     g_debug("xfce output workarea for ID %d", wl_proxy_get_id((struct wl_proxy *)xfce_output));
     XfwMonitorManagerWayland *monitor_manager = data;
@@ -773,6 +783,7 @@
     .pointer_enter = xfce_output_pointer_enter,
     .pointer_leave = xfce_output_pointer_leave,
     .done = xfce_output_done,
+    .not_primary = xfce_output_not_primary,
 };
 
 static void
