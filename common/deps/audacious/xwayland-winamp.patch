+static const char * forced_backend_var;
+
+static void force_xwayland_if_needed()
+{
+    if (aud_get_headless_mode() || !g_getenv("DISPLAY"))
+        return;
+
+    bool qt = (aud_get_mainloop_type() == MainloopType::Qt);
+    PluginHandle * skins = aud_plugin_lookup_basename(qt ? "skins-qt" : "skins");
+    bool winamp = skins && aud_plugin_get_enabled(skins);
+
+    if (!aud_get_bool("use_xwayland") && !winamp)
+        return;
+
+    forced_backend_var = qt ? "QT_QPA_PLATFORM" : "GDK_BACKEND";
+    g_setenv(forced_backend_var, qt ? "xcb" : "x11", true);
+}
+
 void start_plugins_one()
 {
     plugin_system_init();
+    force_xwayland_if_needed();
 
     start_plugins(PluginType::Transport);
     start_plugins(PluginType::Playlist);
@@ -207,6 +228,9 @@ void start_plugins_two()
     start_plugins(PluginType::Vis);
     start_plugins(PluginType::General);
     start_plugins(PluginType::Iface);
+
+    if (forced_backend_var)
+        g_unsetenv(forced_backend_var);
 }
 
