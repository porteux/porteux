+typedef struct {
+	const char  *dir;
+	char       **uris;
+	gboolean     extracting;
+	gboolean     ok;
+} DragUriData;
+
+static void
+drag_uri_data_free (DragUriData *data)
+{
+	g_strfreev (data->uris);
+	g_free (data);
+}
+
+static gboolean archive_is_encrypted (FrWindow *window, GList *file_list);
+
+static void
+drag_uri_stop_waiting (DragUriData *data)
+{
+	data->extracting = FALSE;
+}
+
+static void
+drag_uri_extract_done_cb (FrArchive   *archive,
+			  FrAction     action,
+			  FrProcError *error,
+			  gpointer     user_data)
+{
+	DragUriData *data = user_data;
+
+	g_signal_handlers_disconnect_by_func (archive, drag_uri_extract_done_cb, data);
+	data->ok = (error->type == FR_PROC_ERROR_NONE);
+	data->extracting = FALSE;
+}
+
+static gboolean
+fr_window_drag_data_get_uris (FrWindow         *window,
+			      GdkDragContext   *context,
+			      GtkSelectionData *selection_data,
+			      gboolean          from_sidebar,
+			      GList            *path_list)
+{
+	DragUriData *data;
+	gulong       destroy_id;
+	gboolean     result = FALSE;
+
+	data = g_object_get_data (G_OBJECT (context), DRAG_URI_DATA);
+	if (data == NULL) {
+		GList       *file_list;
+		char        *base_dir;
+		char        *temp_dir;
+		CommandData *cdata;
+
+		if (window->priv->activity_ref > 0)
+			return FALSE;
+
+		if (from_sidebar)
+			file_list = fr_window_get_selection (window, TRUE, &base_dir);
+		else {
+			file_list = fr_window_get_file_list_from_path_list (window, path_list, NULL);
+			base_dir = g_strdup (fr_window_get_current_location (window));
+		}
+
+		temp_dir = NULL;
+		if ((file_list != NULL) && ! (archive_is_encrypted (window, file_list) && (window->priv->password == NULL)))
+			temp_dir = get_temp_work_dir (NULL);
+		if (temp_dir == NULL) {
+			path_list_free (file_list);
+			g_free (base_dir);
+			return FALSE;
+		}
+
+		cdata = g_new0 (CommandData, 1);
+		cdata->temp_dir = temp_dir;
+		CommandList = g_list_prepend (CommandList, cdata);
+
+		data = g_new0 (DragUriData, 1);
+		data->dir = temp_dir;
+		data->extracting = TRUE;
+		g_object_set_data_full (G_OBJECT (context), DRAG_URI_DATA, data, (GDestroyNotify) drag_uri_data_free);
+
+		g_signal_connect (G_OBJECT (window->archive),
+				  "done",
+				  G_CALLBACK (drag_uri_extract_done_cb),
+				  data);
+
+		window->priv->ask_to_open_destination_after_extraction = FALSE;
+		fr_process_clear (window->archive->process);
+		fr_archive_extract_to_local (window->archive,
+					     file_list,
+					     temp_dir,
+					     base_dir,
+					     FALSE,
+					     TRUE,
+					     FALSE,
+					     window->priv->password);
+		fr_process_start (window->archive->process);
+
+		path_list_free (file_list);
+		g_free (base_dir);
+	}
+
+	g_object_ref (context);
+	g_object_ref (window);
+	destroy_id = g_signal_connect_swapped (window, "destroy", G_CALLBACK (drag_uri_stop_waiting), data);
+
+	while (data->extracting)
+		g_main_context_iteration (NULL, TRUE);
+
+	g_signal_handler_disconnect (window, destroy_id);
+	if (window->archive != NULL)
+		g_signal_handlers_disconnect_by_func (window->archive, drag_uri_extract_done_cb, data);
+
+	if (data->ok && (data->uris == NULL)) {
+		GDir *dir = g_dir_open (data->dir, 0, NULL);
+
+		if (dir != NULL) {
+			GPtrArray  *uris = g_ptr_array_new ();
+			const char *name;
+
+			while ((name = g_dir_read_name (dir)) != NULL) {
+				char *path = g_build_filename (data->dir, name, NULL);
+				char *uri = g_filename_to_uri (path, NULL, NULL);
+
+				if (uri != NULL)
+					g_ptr_array_add (uris, uri);
+				g_free (path);
+			}
+			g_dir_close (dir);
+			g_ptr_array_add (uris, NULL);
+			data->uris = (char **) g_ptr_array_free (uris, FALSE);
+		}
+	}
+
+	if ((data->uris != NULL) && (data->uris[0] != NULL))
+		result = gtk_selection_data_set_uris (selection_data, data->uris);
+
+	g_object_unref (window);
+	g_object_unref (context);
+
+	return result;
+}
