+#ifdef USE_APPINDICATOR
+enum {
+    SI_INDICATOR_ITEM_PAUSE = 3,
+    SI_INDICATOR_ITEM_NEXT = 6
+};
+
+static const char * const si_indicator_title_hooks[] = {
+    "title change",
+    "playback ready",
+    "playback stop"
+};
+
+static AppIndicator * si_indicator = nullptr;
+
+static void si_indicator_toggle_window (GtkMenuItem *, void *)
+{
+    if (! aud_get_headless_mode ())
+        aud_ui_show (! aud_ui_is_shown ());
+}
+
+static void si_indicator_scroll (AppIndicator *, int, GdkScrollDirection direction, void *)
+{
+    GdkEventScroll event {};
+    event.direction = direction;
+    si_cb_btscroll (nullptr, & event);
+}
+
+static void si_indicator_update_title (void *, void *)
+{
+    String title = aud_drct_get_playing () ? aud_drct_get_title () : String ();
+    app_indicator_set_title (si_indicator, title ? (const char *) title : _("Audacious"));
+}
+
+static void si_indicator_enable (bool enable)
+{
+    if (enable && ! si_indicator)
+    {
+        GtkWidget * toggle = gtk_menu_item_new_with_mnemonic (_("_Show/Hide Audacious"));
+        g_signal_connect (toggle, "activate", (GCallback) si_indicator_toggle_window, nullptr);
+
+        GtkWidget * menu = si_menu_create ();
+        gtk_menu_shell_prepend ((GtkMenuShell *) menu, gtk_separator_menu_item_new ());
+        gtk_menu_shell_prepend ((GtkMenuShell *) menu, toggle);
+        gtk_widget_show_all (menu);
+
+        GtkIconTheme * theme = gtk_icon_theme_get_default ();
+        const char * icon = gtk_icon_theme_has_icon (theme, "audacious-panel") ?
+         "audacious-panel" : "audacious";
+
+        si_indicator = app_indicator_new ("audacious", icon,
+         APP_INDICATOR_CATEGORY_APPLICATION_STATUS);
+        app_indicator_set_menu (si_indicator, (GtkMenu *) menu);
+        app_indicator_set_status (si_indicator, APP_INDICATOR_STATUS_ACTIVE);
+        g_signal_connect (si_indicator, "scroll-event", (GCallback) si_indicator_scroll, nullptr);
+
+        si_indicator_update_middle_click ();
+        si_indicator_update_title (nullptr, nullptr);
+
+        for (const char * hook : si_indicator_title_hooks)
+            hook_associate (hook, si_indicator_update_title, nullptr);
+        hook_associate ("window close", si_window_close, nullptr);
+    }
+
+    if (! enable && si_indicator)
+    {
+        PluginHandle * si = aud_plugin_by_header (& aud_plugin_instance);
+        if (! aud_plugin_get_enabled (si) && ! aud_get_headless_mode () && ! aud_ui_is_shown ())
+            aud_ui_show (true);
+
+        for (const char * hook : si_indicator_title_hooks)
+            hook_dissociate (hook, si_indicator_update_title);
+        hook_dissociate ("window close", si_window_close);
+
+        g_object_unref (si_indicator);
+        si_indicator = nullptr;
+    }
+}
+#endif
+
+static void si_indicator_update_middle_click ()
+{
+#ifdef USE_APPINDICATOR
+    if (! si_indicator)
+        return;
+
+    int index = (aud_get_int ("statusicon", "middle_click_action") ==
+     SI_CFG_MIDDLE_CLICK_ACTION_NEXT) ? SI_INDICATOR_ITEM_NEXT : SI_INDICATOR_ITEM_PAUSE;
+
+    GList * items = gtk_container_get_children ((GtkContainer *) app_indicator_get_menu (si_indicator));
+    app_indicator_set_secondary_activate_target (si_indicator,
+     (GtkWidget *) g_list_nth_data (items, index));
+    g_list_free (items);
+#endif
+}
