+#ifdef USE_APPINDICATOR
+    if (g_getenv ("WAYLAND_DISPLAY"))
+    {
+        si_indicator_enable (enable);
+        return;
+    }
+#endif
+
     if (enable && ! si_applet)
     {
         si_applet = si_create ();
