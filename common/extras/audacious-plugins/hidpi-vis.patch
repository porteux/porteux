+/* ---- hi-res analyzer: the core's 512-point FFT resolves the whole bass
+   region into 2-3 bins, so a dense hi-res graph only repeats them in
+   staircase plateaus.  Re-run the transform on the same 512 frames the
+   core hands us, zero-padded to 2048, which interpolates that spectrum
+   exactly onto a 4x finer bin grid.  The blocks arrive 33 ms apart and
+   are not contiguous, so they must not be concatenated. ---- */
+#define HD_N 2048
+
+static float hd_pcm[512];
+static float hd_freq[HD_N / 2];
+static bool hd_have = false;
+
+static void hd_feed (const float * pcm)
+{
+    memcpy (hd_pcm, pcm, sizeof hd_pcm);
+    hd_have = true;
+}
+
+static void hd_fft ()
+{
+    static float window[512];
+    static int rev[HD_N];
+    static bool init = false;
+
+    if (! init)
+    {
+        /* the core's window and scaling, so hd bin 4 * (n + 1) comes out
+           equal to the core's freq[n] */
+        for (int i = 0; i < 512; i ++)
+            window[i] = 1 - 0.85f * cosf (2 * (float) M_PI * i / 512);
+        for (int i = 0; i < HD_N; i ++)
+        {
+            int r = 0;
+            for (int b = 0; (1 << b) < HD_N; b ++)
+                r = (r << 1) | ((i >> b) & 1);
+            rev[i] = r;
+        }
+        init = true;
+    }
+
+    static float re[HD_N], im[HD_N];
+    memset (re, 0, sizeof re);
+    memset (im, 0, sizeof im);
+    for (int i = 0; i < 512; i ++)
+        re[rev[i]] = hd_pcm[i] * window[i];
+
+    for (int len = 2; len <= HD_N; len <<= 1)
+    {
+        float ang = -2 * (float) M_PI / len;
+        float wr = cosf (ang), wi = sinf (ang);
+        for (int i = 0; i < HD_N; i += len)
+        {
+            float cr = 1, ci = 0;
+            for (int j = 0; j < len / 2; j ++)
+            {
+                float vr = re[i + j + len / 2] * cr - im[i + j + len / 2] * ci;
+                float vi = re[i + j + len / 2] * ci + im[i + j + len / 2] * cr;
+                re[i + j + len / 2] = re[i + j] - vr;
+                im[i + j + len / 2] = im[i + j] - vi;
+                re[i + j] += vr;
+                im[i + j] += vi;
+                float nr = cr * wr - ci * wi;
+                ci = cr * wi + ci * wr;
+                cr = nr;
+            }
+        }
+    }
+
+    for (int k = 0; k < HD_N / 2; k ++)
+        hd_freq[k] = sqrtf (re[k] * re[k] + im[k] * im[k]) * 2 / 512;
+}
