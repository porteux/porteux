+/* same log mapping over the 1024-bin local FFT; xscale is in hd-bin
+   units, where the core's index n sits at hd bin 4 * (n + 1), and the
+   band widths are normalised back to core-bin units so levels match the
+   256-bin path */
+static void make_log_graph_hd (int bands, int db_range, int int_range,
+ unsigned char * graph)
+{
+    static int last_bands = 0;
+    static Index<float> xscale;
+
+    if (bands != last_bands)
+    {
+        xscale.resize (bands + 1);
+        for (int i = 0; i <= bands; i ++)
+            xscale[i] = (powf (256, (float) i / bands) + 0.5f) * 4;
+        last_bands = bands;
+    }
+
+    for (int i = 0; i < bands; i ++)
+    {
+        float val;
+        float width = xscale[i + 1] - xscale[i];
+
+        if (width < 1.0f)
+        {
+            float m = interp_bin (hd_freq, HD_N / 2,
+             (xscale[i] + xscale[i + 1]) / 2);
+            float w = width / 4 * (float) bands / 12;
+            val = 20 * log10f (aud::max (m, 1e-9f) * w);
+        }
+        else
+        {
+            int a = ceilf (xscale[i]);
+            int b = floorf (xscale[i + 1]);
+            float n = 0;
+            if (a > 0 && a - 1 < HD_N / 2)
+                n += hd_freq[a - 1] * (a - xscale[i]);
+            for (; a < b && a < HD_N / 2; a ++)
+                n += hd_freq[a];
+            if (b < HD_N / 2)
+                n += hd_freq[b] * (xscale[i + 1] - b);
+            n *= (float) bands / 12 * 0.25f;
+            val = 20 * log10f (aud::max (n, 1e-9f));
+        }
+
+        val = (1 + val / db_range) * int_range;
+        graph[i] = aud::clamp ((int) val, 0, int_range);
+    }
+}
