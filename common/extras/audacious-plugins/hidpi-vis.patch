+/* magnitude at a fractional bin, Catmull-Rom over the four nearest bins:
+   dense hi-res graphs then curve smoothly instead of repeating bins in
+   staircase plateaus, and interpolating magnitude (not dB) keeps the wide
+   shoulders of tonal peaks that upstream's bin summation produces */
+static float interp_bin (const float * mag, int nbins, float c)
+{
+    int k = aud::clamp ((int) c, 0, nbins - 1);
+    float t = c - k;
+    float d[4];
+    for (int j = 0; j < 4; j ++)
+        d[j] = mag[aud::clamp (k + j - 1, 0, nbins - 1)];
+    return d[1] + 0.5f * t * (d[2] - d[0] + t * (2 * d[0]
+     - 5 * d[1] + 4 * d[2] - d[3] + t * (3 * (d[1] - d[2])
+     + d[3] - d[0])));
+}
