#!/bin/bash

source "$BUILDER_UTILS_PATH/latest-from-github.sh"

PRGNAM=cosmic-icons

CWD=$(dirname "$0")
TMP=$MODULE_PATH/$PRGNAM
PKG=$TMP/package

set -e

[ -e $TMP ] && rm -rf $TMP
mkdir -p $TMP $PKG
cd $TMP

VERSION=$(download_master_from_github pop-os $PRGNAM) || exit 1
cd $PRGNAM-master || exit 1

just rootdir=$PKG install

# merge with pop-icon-theme
ROOT=./ installpkg $CWD/pop-icon-theme-*.txz
rm usr/share/icons/Pop/*/apps/browser.* # remove this to not mess with our AppStore icon
cp -rn usr/share/icons/Pop/* $PKG/usr/share/icons/Cosmic/

gtk-update-icon-cache $PKG/usr/share/icons/Cosmic

mkdir -p $PKG/install
cat $CWD/slack-desc > $PKG/install/slack-desc

cd $MODULE_PATH/$PRGNAM/package
makepkg ${MAKEPKG_FLAGS} $MODULE_PATH/packages/$PRGNAM-$VERSION-${ARCH}-1_porteux.txz > /dev/null 2>&1
