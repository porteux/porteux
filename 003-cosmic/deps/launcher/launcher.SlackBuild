#!/bin/bash

PRGNAM=launcher

CWD=$(dirname "$0")
TMP=$MODULE_PATH/$PRGNAM
PKG=$TMP/package

set -e

[ -e $TMP ] && rm -rf $TMP
mkdir -p $TMP $PKG
cd $TMP

git clone https://github.com/pop-os/$PRGNAM
cd $PRGNAM
VERSION=$(git log -1 --date=format:"%Y%m%d" --format="%ad")

# make sure binaries go into lib64 in case of x64 system
sed -i "s|base-dir / 'lib'|base-dir / 'lib${SYSTEM_BITS}'|g" justfile
sed -i "s|/usr/lib/pop-launcher|/usr/lib${SYSTEM_BITS}/pop-launcher|" src/lib.rs

ls rust-toolchain* 1> /dev/null 2>&1 && rm rust-toolchain*
just build-release --target x86_64-unknown-linux-gnu
rsync -r ./target/x86_64-unknown-linux-gnu/release ./target/ --remove-source-files
just rootdir=$MODULE_PATH/$PRGNAM/package install

mkdir -p $PKG/install
cat $CWD/slack-desc > $PKG/install/slack-desc

cd $MODULE_PATH/$PRGNAM/package
makepkg ${MAKEPKG_FLAGS} $MODULE_PATH/packages/$PRGNAM-$VERSION-${ARCH}-1_porteux.txz
