#!/bin/bash

PRGNAM=greetd

CWD=$(dirname "$0")
TMP=$MODULE_PATH/$PRGNAM
PKG=$TMP/package

set -e

[ -e $TMP ] && rm -rf $TMP
mkdir -p $TMP $PKG
cd $TMP

wget https://git.sr.ht/~kennylevinsen/$PRGNAM/archive/master.tar.gz -O $PRGNAM-master.tar.gz || exit 1
tar xf $PRGNAM-master.tar.gz || exit 1
cd $PRGNAM-master || exit 1
VERSION=$(date -r . +%Y%m%d)

cargo build --release --target x86_64-unknown-linux-gnu

install -Dm755 -t "$PKG/usr/bin/" "target/x86_64-unknown-linux-gnu/release/agreety"
install -Dm755 -t "$PKG/usr/bin/" "target/x86_64-unknown-linux-gnu/release/fakegreet"
install -Dm755 -t "$PKG/usr/bin/" "target/x86_64-unknown-linux-gnu/release/$PRGNAM"
install -Dm644 "$CWD/config.toml" $PKG/etc/greetd/config.toml

mkdir -p $PKG/install
cat $CWD/slack-desc > $PKG/install/slack-desc

cd $PKG
makepkg ${MAKEPKG_FLAGS} $MODULE_PATH/packages/$PRGNAM-$VERSION-${ARCH}-1_porteux.txz
