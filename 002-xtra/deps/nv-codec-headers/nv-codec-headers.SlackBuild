#!/bin/bash

source "$BUILDER_UTILS_PATH/latest-from-github.sh"

PRGNAM=nv-codec-headers

CWD=$(dirname "$0")
TMP=$MODULE_PATH/$PRGNAM
PKG=$TMP/package-$PRGNAM

set -e

[ -e $TMP ] && rm -rf $TMP
mkdir -p $TMP $PKG
cd $TMP

VERSION=$(download_master_from_github FFmpeg nv-codec-headers) || exit 1
cd nv-codec-headers-master || exit 1

make -j${NUMBER_THREADS} PREFIX=/usr LIBDIR=lib${SYSTEM_BITS} DESTDIR=$PKG install

cd $PKG
makepkg ${MAKEPKG_FLAGS} $MODULE_PATH/packages/$PRGNAM-$VERSION-noarch-1_porteux.txz
