#!/bin/bash

PRGNAM=nv-codec-headers

CWD=$(dirname "$0")
TMP=$MODULEPATH/$PRGNAM
PKG=$TMP/package-$PRGNAM

set -e

[ -e $TMP ] && rm -rf $TMP
mkdir -p $TMP $PKG
cd $TMP

wget https://github.com/FFmpeg/nv-codec-headers/archive/refs/heads/master.tar.gz -O ${PRGNAM}.tar.gz
tar xf ${PRGNAM}.tar.gz
cd nv-codec-headers-master
VERSION=$(date -r . +%Y%m%d)

make -j${NUMBERTHREADS} PREFIX=/usr LIBDIR=lib${SYSTEMBITS} DESTDIR=$PKG install

cd $PKG
makepkg ${MAKEPKGFLAGS} $MODULEPATH/packages/$PRGNAM-$VERSION-noarch-1_porteux.txz
