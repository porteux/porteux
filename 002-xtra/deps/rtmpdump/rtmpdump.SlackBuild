#!/bin/bash

PRGNAM=rtmpdump

CWD=$(dirname "$0")
TMP=$MODULE_PATH/$PRGNAM
PKG=$TMP/package-$PRGNAM

set -e

[ -e $TMP ] && rm -rf $TMP
mkdir -p $TMP $PKG
cd $TMP

git clone git://git.ffmpeg.org/${PRGNAM}.git
cd $PRGNAM
VERSION=`git log -1 --date=format:"%Y%m%d" --format="%ad"`

# patch makefiles for shared library install
patch -p1 < $CWD/librtmp-makefile.patch

# use gnutls instead of openssl
sed -i \
	-e 's/^CRYPTO=OPENSSL/#CRYPTO=OPENSSL/' \
	-e 's/#CRYPTO=GNUTLS/CRYPTO=GNUTLS/' \
	Makefile librtmp/Makefile

CFLAGS="$GCC_CFLAGS" \
make -j${NUMBER_THREADS} \
	prefix=/usr \
	libdir=/usr/lib${SYSTEM_BITS} \
	DESTDIR=$PKG \
	install

find $PKG -type f -name "*.a" -exec rm -f {} \;
find $PKG -type f -name "*.la" -exec rm -f {} \;

rm -fr $PKG/usr/bin
rm -fr $PKG/usr/sbin

mkdir -p $PKG/install
cat $CWD/slack-desc > $PKG/install/slack-desc

cd $PKG
makepkg ${MAKEPKG_FLAGS} $MODULE_PATH/packages/$PRGNAM-$VERSION-$ARCH-1_porteux.txz