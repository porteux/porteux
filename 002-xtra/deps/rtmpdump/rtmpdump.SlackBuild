#!/bin/bash

source "$BUILDER_UTILS_PATH/latest-from-github.sh"

PRGNAM=rtmpdump

CWD=$(dirname "$0")
TMP=$MODULE_PATH/$PRGNAM
PKG=$TMP/package-$PRGNAM

set -e

[ -e $TMP ] && rm -rf $TMP
mkdir -p $TMP $PKG
cd $TMP

VERSION=$(download_master_from_github mirror $PRGNAM) || exit 1
cd $PRGNAM-master

# patch makefiles for shared library install
patch -p1 < $CWD/librtmp-makefile.patch

# use gnutls instead of openssl
sed -i \
	-e 's/^CRYPTO=OPENSSL/#CRYPTO=OPENSSL/' \
	-e 's/#CRYPTO=GNUTLS/CRYPTO=GNUTLS/' \
	Makefile librtmp/Makefile

XCFLAGS="$GCC_CFLAGS" \
make -j${NUMBER_THREADS} \
	prefix=/usr \
	libdir=/usr/lib${SYSTEM_BITS} \
	DESTDIR=$PKG \
	install

find $PKG -type f -name "*.a" -exec rm -f {} \;
find $PKG -type f -name "*.la" -delete

rm -fr "${PKG:?}/usr/bin"
rm -fr "${PKG:?}/usr/sbin"

mkdir -p $PKG/install
cat $CWD/slack-desc > $PKG/install/slack-desc

cd $PKG
makepkg ${MAKEPKG_FLAGS} $MODULE_PATH/packages/$PRGNAM-$VERSION-$ARCH-1_porteux.txz