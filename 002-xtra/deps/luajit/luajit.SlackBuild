#!/bin/bash

source "$BUILDER_UTILS_PATH/latest-from-github.sh"

PRGNAM=LuaJIT

CWD=$(dirname "$0")
TMP=$MODULE_PATH/${PRGNAM,,}
PKG=$TMP/package-${PRGNAM,,}

set -e

[ -e $TMP ] && rm -rf $TMP
mkdir -p $TMP $PKG
cd $TMP

VERSION=$(download_master_from_github $PRGNAM $PRGNAM) || exit 1
cd LuaJIT-master || exit 1

sed -i -e '/-DLUAJIT_ENABLE_LUA52COMPAT/s/^#//' src/Makefile

CFLAGS="${GCC_CFLAGS/-fno-unwind-tables -fno-asynchronous-unwind-tables/} -ffat-lto-objects" \
CXXFLAGS="${GCC_CXXFLAGS/-fno-unwind-tables -fno-asynchronous-unwind-tables/}" \
make -j${NUMBER_THREADS} PREFIX=/usr INSTALL_LIB=/usr/lib${SYSTEM_BITS}
make PREFIX=/usr INSTALL_LIB=${PKG}/usr/lib${SYSTEM_BITS} install DESTDIR=${PKG}

find $PKG -type f -name "*.a" -exec rm -f {} \;
rm -fr $PKG/usr/share/lua-jit

mkdir -p $PKG/install
cat $CWD/slack-desc > $PKG/install/slack-desc

cd $PKG
makepkg ${MAKEPKG_FLAGS} $MODULE_PATH/packages/${PRGNAM,,}-$VERSION-$ARCH-1_porteux.txz