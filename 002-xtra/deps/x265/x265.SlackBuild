#!/bin/bash

PRGNAM=x265

CWD=$(dirname "$0")
TMP=$MODULE_PATH/$PRGNAM
PKG=$TMP/package-$PRGNAM

set -e

[ -e $TMP ] && rm -rf $TMP
mkdir -p $TMP $PKG
cd $TMP

wget https://bitbucket.org/multicoreware/${PRGNAM}_git/get/HEAD.tar.gz
tar xf HEAD.tar.gz && rm HEAD.tar.gz
cd multicoreware-${PRGNAM}*
VERSION=$(date -r . +%Y%m%d)

BUILDPARAMS="${CLANG_CXXFLAGS} -ffat-lto-objects"

patch -p1 < $CWD/build-fix.patch

for bits in 12 10; do
	main12=OFF
	if [ $bits = 12 ]; then
		main12=ON
	fi

	LDFLAGS="$LLDFLAGS" \
	cmake -B build-$bits \
		-G Ninja \
		-Ssource \
		-Wno-dev \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_CXX_COMPILER=clang++ \
		-DCMAKE_CXX_FLAGS="$BUILDPARAMS" \
		-DCMAKE_ASM_NASM_FLAGS='-w-macro-params-legacy' \
		-DENABLE_HDR10_PLUS=ON \
		-DENABLE_CLI=OFF \
		-DENABLE_SHARED=OFF \
		-DEXPORT_C_API=OFF \
		-DHIGH_BIT_DEPTH=ON \
		-DMAIN12=$main12

	cmake --build build-$bits -- -j${NUMBER_THREADS}
done

LDFLAGS="$LLDFLAGS" \
cmake -B build \
	-G Ninja \
	-Ssource \
	-Wno-dev \
	-DCMAKE_BUILD_TYPE=Release \
	-DCMAKE_CXX_COMPILER=clang++ \
	-DCMAKE_CXX_FLAGS="$BUILDPARAMS" \
	-DCMAKE_ASM_NASM_FLAGS='-w-macro-params-legacy' \
	-DCMAKE_INSTALL_PREFIX=/usr \
	-DLIB_INSTALL_DIR=lib${SYSTEM_BITS} \
	-DENABLE_HDR10_PLUS=ON \
	-DENABLE_CLI=OFF \
	-DENABLE_SHARED=ON \
	-DEXTRA_LIB="x265_main10.a;x265_main12.a" \
	-DEXTRA_LINK_FLAGS="-L." \
	-DLINKED_10BIT=ON \
	-DLINKED_12BIT=ON

ln -s ../build-10/libx265.a build/libx265_main10.a
ln -s ../build-12/libx265.a build/libx265_main12.a

DESTDIR="$PKG" cmake --build build --target install -- -j${NUMBER_THREADS}

find $PKG -type f -name "*.a" -exec rm -f {} \;

mkdir -p $PKG/install
cat $CWD/slack-desc > $PKG/install/slack-desc

cd $PKG
makepkg ${MAKEPKG_FLAGS} $MODULE_PATH/packages/$PRGNAM-$VERSION-$ARCH-1_porteux.txz
