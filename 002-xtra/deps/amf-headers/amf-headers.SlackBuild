#!/bin/bash

source "$BUILDER_UTILS_PATH/latest-from-github.sh"

PRGNAM=AMF-headers

CWD=$(dirname "$0")
TMP=$MODULE_PATH/$PRGNAM
PKG=$TMP/package-$PRGNAM

set -e

[ -e $TMP ] && rm -rf $TMP
mkdir -p $TMP $PKG
cd $TMP

VERSION=$(get_latest_version_tag_from_github "GPUOpen-LibrariesAndSDKs" "AMF")
wget https://github.com/GPUOpen-LibrariesAndSDKs/AMF/releases/download/${VERSION}/${PRGNAM}-${VERSION}.tar.gz

tar xf ${PRGNAM}-${VERSION}.tar.?z

mkdir -p $PKG/usr/include
cp -r ${PRGNAM,,}-${VERSION}/AMF $PKG/usr/include

cd $PKG
makepkg ${MAKEPKG_FLAGS} $MODULE_PATH/packages/${PRGNAM,,}-${VERSION//[vV]}-noarch-1_porteux.txz