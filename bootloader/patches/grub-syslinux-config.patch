+static grub_err_t
+print_args (struct output_buffer *outbuf, const char *from, const char *to)
+{
+  grub_err_t err;
+  const char *start, *ptr;
+  int escape, quoted;
+  if (!to)
+    to = from + grub_strlen (from);
+  for (start = from; start < to; start = ptr)
+    {
+      for (; start < to && grub_isspace (*start); start++);
+      if (start == to)
+	break;
+      escape = quoted = 0;
+      for (ptr = start; ptr < to && (quoted || ! grub_isspace (*ptr)); ptr++)
+	if (*ptr == '"')
+	  quoted = ! quoted;
+	else if (! grub_isalnum (*ptr) && ! grub_strchr ("/._-+=,:@%", *ptr))
+	  escape = 1;
+      err = ensure_space (outbuf, (ptr - start) * 4 + 3);
+      if (err)
+	return err;
+      outbuf->buf[outbuf->ptr++] = ' ';
+      if (escape)
+	outbuf->buf[outbuf->ptr++] = '\'';
+      for (; start < ptr; start++)
+	if (*start == '\'')
+	  {
+	    outbuf->buf[outbuf->ptr++] = '\'';
+	    outbuf->buf[outbuf->ptr++] = '\\';
+	    outbuf->buf[outbuf->ptr++] = '\'';
+	    outbuf->buf[outbuf->ptr++] = '\'';
+	  }
+	else if (*start != '"')
+	  outbuf->buf[outbuf->ptr++] = *start;
+      if (escape)
+	outbuf->buf[outbuf->ptr++] = '\'';
+    }
+  return GRUB_ERR_NONE;
+}
