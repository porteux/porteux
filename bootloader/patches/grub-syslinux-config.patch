+static grub_err_t
+grub_cmd_kernel (grub_command_t cmd __attribute__ ((unused)),
+		 int argc, char **args)
+{
+#ifdef GRUB_MACHINE_PCBIOS
+  const char *linux_command = "linux16", *initrd_command = "initrd16";
+#else
+  const char *linux_command = "linux", *initrd_command = "initrd";
+#endif
+  char **kernel_args, **initrd_args;
+  int kernel_argc = 0, initrd_argc = 0, capacity = argc, i;
+  char *part, *comma;
+  grub_err_t err;
+  struct grub_video_mode_info mode_info;
+
+  if (argc == 0)
+    return grub_error (GRUB_ERR_BAD_ARGUMENT, N_("filename expected"));
+
+  if (grub_video_get_info (&mode_info) == GRUB_ERR_NONE)
+    {
+      grub_video_set_active_render_target (GRUB_VIDEO_RENDER_TARGET_DISPLAY);
+      grub_video_set_viewport (0, 0, mode_info.width, mode_info.height);
+      grub_video_fill_rect (grub_video_map_rgb (0, 0, 0), 0, 0,
+			    mode_info.width, mode_info.height);
+      grub_video_swap_buffers ();
+    }
+
+  for (i = 1; i < argc; i++)
+    for (part = args[i]; *part; part++)
+      if (*part == ',')
+	capacity++;
+
+  kernel_args = grub_calloc (argc + 1, sizeof (kernel_args[0]));
+  initrd_args = grub_calloc (capacity + 1, sizeof (initrd_args[0]));
+  if (! kernel_args || ! initrd_args)
+    {
+      grub_free (kernel_args);
+      grub_free (initrd_args);
+      return grub_errno;
+    }
+
+  for (i = 0; i < argc; i++)
+    if (i > 0 && grub_strncasecmp (args[i], "initrd=", sizeof ("initrd=") - 1) == 0)
+      for (part = args[i] + sizeof ("initrd=") - 1; part; part = comma ? comma + 1 : NULL)
+	{
+	  comma = grub_strchr (part, ',');
+	  if (comma)
+	    *comma = '\0';
+	  if (*part)
+	    initrd_args[initrd_argc++] = part;
+	}
+    else
+      kernel_args[kernel_argc++] = args[i];
+
+  err = grub_command_execute (linux_command, kernel_argc, kernel_args);
+  if (err == GRUB_ERR_NONE && initrd_argc > 0)
+    err = grub_command_execute (initrd_command, initrd_argc, initrd_args);
+
+  grub_free (kernel_args);
+  grub_free (initrd_args);
+  return err;
+}
