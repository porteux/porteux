#!/bin/bash

PRGNAM=exempi

CWD=$(dirname "$0")
TMP=$MODULE_PATH/$PRGNAM
PKG=$TMP/package-$PRGNAM

set -e

[ -e $TMP ] && rm -rf $TMP
mkdir -p $TMP $PKG
cd $TMP

wget https://gitlab.freedesktop.org/libopenraw/${PRGNAM}/-/archive/main/${PRGNAM}-main.tar.gz
tar xf ${PRGNAM}-main.tar.?z*
cd ${PRGNAM}-main
VERSION=$(date -r . +%Y%m%d)

CFLAGS="$GCC_CFLAGS" \
CXXFLAGS="$GCC_CXXFLAGS" \
./autogen.sh \
	--prefix=/usr \
	--libdir=/usr/lib${SYSTEM_BITS} \
	--localstatedir=/var \
	--sysconfdir=/etc \
	--disable-static \
	--enable-samples=no \
	--enable-unittest=no

make -j${NUMBER_THREADS} install-strip DESTDIR=$PKG

find $PKG -type f -name "*.la" -delete

mkdir -p $PKG/install
cat $CWD/slack-desc > $PKG/install/slack-desc

cd $PKG
makepkg ${MAKEPKG_FLAGS} $MODULE_PATH/packages/${PRGNAM}-$VERSION-$ARCH-1_porteux.txz
