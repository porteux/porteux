#!/bin/bash

PRGNAM=libnma

CWD=$(dirname "$0")
TMP=$MODULE_PATH/$PRGNAM
PKG=$TMP/package-$PRGNAM

set -e

[ -e $TMP ] && rm -rf $TMP
mkdir -p $TMP $PKG
cd $TMP

wget https://gitlab.gnome.org/GNOME/${PRGNAM}/-/archive/main/${PRGNAM}-main.tar.gz
tar xf ${PRGNAM}-main.tar.?z*
cd ${PRGNAM}-main
VERSION=$(date -r . +%Y%m%d)

mkdir meson-build && cd meson-build
CFLAGS="$GCC_CFLAGS" \
meson setup \
	--buildtype=release \
	--prefix=/usr \
	--libdir=/usr/lib${SYSTEM_BITS} \
	--sysconfdir=/etc \
	--localstatedir=/var \
	-Dlibnma_gtk4=true \
	-Dgtk_doc=false

DESTDIR=$PKG ninja -j${NUMBER_THREADS} install

# Remove all extra bits included in the base libnma package
# This package is _ONLY_ for the gtk4 lib
rm -r $PKG/usr/include
rm -r $PKG/usr/share/glib-2.0
rm -r $PKG/usr/share/locale
rm -f $PKG/usr/share/vala/vapi/libnma.deps
rm -f $PKG/usr/share/vala/vapi/libnma.vapi
rm -f $PKG/usr/share/gir-1.0/NMA-1.0.gir

rm -f $PKG/usr/lib${SYSTEM_BITS}/girepository-1.0/NMA-1.0.typelib
rm -f $PKG/usr/lib${SYSTEM_BITS}/pkgconfig/libnma.pc
rm -f $PKG/usr/lib${SYSTEM_BITS}/libnma.so*

find $PKG -type f -name "*.la" -delete

mkdir -p $PKG/install
cat $CWD/slack-desc > $PKG/install/slack-desc

cd $PKG
makepkg ${MAKEPKG_FLAGS} $MODULE_PATH/packages/${PRGNAM}-gtk4-$VERSION-$ARCH-1_porteux.txz
