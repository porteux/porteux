#!/bin/bash

PRGNAM=cogl

CWD=$(dirname "$0")
TMP=$MODULE_PATH/$PRGNAM
PKG=$TMP/package-$PRGNAM

set -e

[ -e $TMP ] && rm -rf $TMP
mkdir -p $TMP $PKG
cd $TMP

VERSION="1.22.8"
wget https://gitlab.gnome.org/GNOME/${PRGNAM}/-/archive/${VERSION}/${PRGNAM}-${VERSION}.tar.gz

tar xf $PRGNAM-$VERSION.tar.?z
cd $PRGNAM-$VERSION

sed -i "s|tests ||g" Makefile.am

CFLAGS="$GCC_CFLAGS -ffat-lto-objects -Wno-incompatible-pointer-types -Wno-error=maybe-uninitialized" \
CXXFLAGS="$GCC_CXXFLAGS" \
./autogen.sh \
	--prefix=/usr \
	--libdir=/usr/lib${SYSTEM_BITS} \
	--sysconfdir=/etc \
	--localstatedir=/var \
	--disable-static \
	--disable-gtk-doc \
	--disable-glibtest \
	--enable-debug=no \
	--enable-deprecated=no \
	--enable-unit-tests=no \
	--enable-maintainer-flags=no \
	--enable-kms-egl-platform \
	--build=$ARCH-porteux-linux

make -j${NUMBER_THREADS} install-strip DESTDIR=$PKG

find $PKG -type f -name "*.la" -delete
rm -fr $PKG/usr/share/cogl

mkdir -p $PKG/install
cat $CWD/slack-desc > $PKG/install/slack-desc

cd $PKG
makepkg ${MAKEPKG_FLAGS} $MODULE_PATH/packages/$PRGNAM-$VERSION-$ARCH-1_porteux.txz
