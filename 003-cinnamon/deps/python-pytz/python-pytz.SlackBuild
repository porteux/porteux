#!/bin/bash

source "$BUILDER_UTILS_PATH/latest-from-github.sh"

PRGNAM=python-pytz

CWD=$(dirname "$0")
TMP=$MODULE_PATH/$PRGNAM
PKG=$TMP/package-$PRGNAM

set -e

[ -e $TMP ] && rm -rf $TMP
mkdir -p $TMP $PKG
cd $TMP

repository="stub42"
project="pytz"

VERSION=$(get_latest_version_tag_from_github ${repository} ${project} | cut -d "_" -f 2)

wget -c https://github.com/$repository/$project/releases/download/release_$VERSION/pytz-$VERSION.tar.gz

tar xf pytz-$VERSION.tar.?z
cd pytz-$VERSION

python setup.py install --root=$PKG

mkdir -p $PKG/install
cat $CWD/slack-desc > $PKG/install/slack-desc

cd $PKG
makepkg ${MAKEPKG_FLAGS} $MODULE_PATH/packages/$PRGNAM-$VERSION-$ARCH-1_porteux.txz
