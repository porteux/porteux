+/*
+ * Collect a "lowerdir+=" layer addition requested on remount.  The path
+ * is resolved and validated here; the layer is added to the mounted
+ * overlay by ovl_dyn_reconfigure().
+ */
+static int ovl_reconf_parse_add(struct fs_context *fc,
+				struct fs_parameter *param)
+{
+	struct ovl_fs_context *ctx = fc->fs_private;
+	struct ovl_fs_context_layer *l;
+	struct path path;
+	char *name;
+	int err;
+
+	if (param->type != fs_value_is_string)
+		return invalfc(fc, "lowerdir+ requires a path on remount");
+
+	if (ctx->nr == OVL_MAX_STACK)
+		return invalfc(fc, "too many lower directories, limit is %d",
+			       OVL_MAX_STACK);
+
+	err = ovl_mount_dir_noesc(param->string, &path);
+	if (err)
+		return err;
+
+	name = kstrdup(param->string, GFP_KERNEL);
+	if (!name) {
+		path_put(&path);
+		return -ENOMEM;
+	}
+
+	err = ovl_ctx_realloc_lower(fc);
+	if (err) {
+		kfree(name);
+		path_put(&path);
+		return err;
+	}
+
+	l = &ctx->lower[ctx->nr++];
+	memset(l, 0, sizeof(*l));
+	l->name = name;
+	l->path = path;
+	return 0;
+}
+
+/* Collect a "lowerdir-=" layer removal requested on remount */
+static int ovl_reconf_parse_del(struct fs_context *fc,
+				struct fs_parameter *param)
+{
+	struct ovl_fs_context *ctx = fc->fs_private;
+	struct path path;
+	int err;
+
+	if (param->type != fs_value_is_string)
+		return invalfc(fc, "lowerdir- requires a path");
+
+	err = ovl_mount_dir_noesc(param->string, &path);
+	if (err)
+		return err;
+
+	if (ctx->nr_dyn_del >= ctx->cap_dyn_del) {
+		size_t cap = max_t(size_t, 4, ctx->cap_dyn_del * 2);
+		struct path *p;
+
+		p = krealloc_array(ctx->dyn_del, cap, sizeof(*p),
+				   GFP_KERNEL_ACCOUNT);
+		if (!p) {
+			path_put(&path);
+			return -ENOMEM;
+		}
+		ctx->dyn_del = p;
+		ctx->cap_dyn_del = cap;
+	}
+
+	ctx->dyn_del[ctx->nr_dyn_del++] = path;
+	return 0;
+}
