+static inline struct inode *ovl_root_inode(struct super_block *sb)
+{
+	return d_inode(sb->s_root);
+}
+
+/*
+ * Swap the root dentry's ovl_entry.  Caller must hold the root
+ * inode lock and ofs->dyn_lock for writing.  Returns the old entry,
+ * which the caller must free with ovl_free_entry() after all
+ * possible readers are done (readers hold ofs->dyn_lock for reading
+ * or the root inode lock).
+ */
+static struct ovl_entry *ovl_dyn_swap_root(struct super_block *sb,
+					   struct ovl_entry *new_oe)
+{
+	struct inode *inode = ovl_root_inode(sb);
+	struct ovl_entry *old_oe = OVL_I_E(inode);
+
+	WRITE_ONCE(OVL_I(inode)->oe, new_oe);
+	/* force the merged readdir cache of the root to be rebuilt */
+	OVL_I(inode)->version++;
+
+	return old_oe;
