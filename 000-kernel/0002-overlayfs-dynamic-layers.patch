+	if (ovl_inode_lower(inode) == d_inode(lowerdentry)) {
+		if (!ovl_inode_upper(inode)) {
+			ovl_inode_update(inode, dget(upperdentry));
+			ok = true;
+		} else {
+			/* raced with another adopter or a copy-up */
+			ok = ovl_inode_upper(inode) == d_inode(upperdentry);
+		}
+	}
+	ovl_inode_unlock(inode);
+
+	return ok;
+}
+
+/* Find an active lower layer whose root is @dentry, or NULL */
+static struct ovl_layer *ovl_dyn_find_layer(struct ovl_fs *ofs,
+					    struct dentry *dentry)
+{
+	unsigned int i;
+
+	for (i = 1; i < ofs->numlayer; i++) {
+		struct ovl_layer *l = &ofs->layers[i];
+
+		if (l->mnt && l->mnt->mnt_root == dentry)
+			return l;
+	}
+	return NULL;
+}
+
+/*
+ * Surgical cache fixup for layer addition.
+ *
+ * Instead of declaring the whole dentry cache stale (generation bump),
+ * walk the added module's directory tree and touch only what the
+ * module can affect:
+ *
+ *  - every cached merged directory the module also provides gets the
+ *    module's real dir inserted at the top of its (RCU-swapped) stack
+ *    and its readdir cache version bumped;
+ *  - cached children (negative entries, or positive ones the module
+ *    now shadows or replaces with a different file type) are
+ *    invalidated by name;
+ *  - anything not cached needs no work: fresh lookups derive from the
+ *    already updated root stack.
+ *
+ * Runs with ofs->dyn_lock held for writing, so no lookup can create
+ * entries from a not-yet-updated directory while the walk is running.
+ * Commits do not take i_rwsem: concurrent stack readers are covered
+ * by the rcu read sections in the accessors, and all dentries of the
+ * superseded arrays stay pinned by the new arrays.
+ *
+ * Returns 0 on success; any error means the caller must fall back to
+ * the generation bump, which is always correct.
+ */
+
+struct ovl_dyn_dirent {
+	struct list_head node;
+	unsigned char d_type;
+	int len;
+	char name[];
+};
+
+struct ovl_dyn_rdd {
+	struct dir_context ctx;
+	struct list_head entries;
+	long *budget;
+	int count;
+	int err;
+};
+
+static bool ovl_dyn_filldir(struct dir_context *ctx, const char *name,
+			    int namelen, loff_t offset, u64 ino,
+			    unsigned int d_type)
+{
+	struct ovl_dyn_rdd *rdd =
+		container_of(ctx, struct ovl_dyn_rdd, ctx);
+	struct ovl_dyn_dirent *ent;
+
+	if (name[0] == '.' && (namelen == 1 ||
+			       (namelen == 2 && name[1] == '.')))
+		return true;
+
+	/*
+	 * Charging the budget here, not just when the entries are
+	 * processed, bounds the memory this list can consume on a
+	 * pathologically large module directory.
+	 */
+	if (--(*rdd->budget) < 0) {
+		rdd->err = -E2BIG;
+		return false;
+	}
+
+	ent = kmalloc(sizeof(*ent) + namelen + 1, GFP_KERNEL);
+	if (!ent) {
+		rdd->err = -ENOMEM;
+		return false;
+	}
+	ent->d_type = d_type;
+	ent->len = namelen;
+	memcpy(ent->name, name, namelen);
+	ent->name[namelen] = 0;
+	list_add_tail(&ent->node, &rdd->entries);
+	rdd->count++;
+	return true;
+}
+
+static void ovl_dyn_free_dirents(struct list_head *entries)
+{
+	struct ovl_dyn_dirent *ent, *tmp;
+
+	list_for_each_entry_safe(ent, tmp, entries, node)
+		kfree(ent);
+}
+
+struct ovl_dyn_qitem {
+	struct list_head node;
+	struct dentry *ovl;	/* cached overlay dir */
+	struct dentry *real;	/* matching dir in the new layer */
+};
+
+struct ovl_dyn_oldoe {
+	struct list_head node;
+	struct ovl_entry *oe;
+};
+
+static int ovl_dyn_queue(struct list_head *queue, struct dentry *ovl,
+			 struct dentry *real)
+{
+	struct ovl_dyn_qitem *qi = kmalloc_obj(*qi, GFP_KERNEL);
+
+	if (!qi)
+		return -ENOMEM;
+	qi->ovl = ovl;		/* consumes references */
+	qi->real = real;
+	list_add_tail(&qi->node, queue);
+	return 0;
+}
+
+static bool ovl_entry_has_layer(struct ovl_entry *oe,
+				const struct ovl_layer *layer);
+
+/*
+ * Overlay inodes are found by lookups through the inode hash, keyed
+ * by the top lower inode - or by the upper inode for pure upper
+ * files (see ovl_get_inode()).  When a dynamic layer change alters a
+ * cached directory's top lower, the cached inode would be left
+ * hashed under its old key: a fresh lookup, hashing by the new top
+ * lower, would miss it and allocate an alias of the directory (see
+ * ovl_dyn_adopt_upper()).  Re-key the inode instead, so lookups keep
+ * finding it.  The private per-inode mutex serializes this against
+ * the hash insertion in ovl_inode_update() (copy-up); lookups are
+ * excluded by dyn_lock, held for writing by every caller.
+ */
+static void ovl_dyn_rekey_inode(struct inode *inode, struct ovl_entry *oe)
+{
+	struct inode *key = ovl_numlower(oe) ?
+			    d_inode(ovl_lowerstack(oe)[0].dentry) :
+			    ovl_inode_upper(inode);
+
+	ovl_inode_lock(inode);
+	if (inode->i_private != key) {
+		if (!inode_unhashed(inode))
+			remove_inode_hash(inode);
+		inode->i_private = key;
+		if (key)
+			__insert_inode_hash(inode, (unsigned long) key);
+	}
+	ovl_inode_unlock(inode);
+}
+
+/* Insert @layer at the top of the lower stack of cached dir @inode */
+static int ovl_dyn_insert_lower(struct inode *inode,
+				struct ovl_layer *layer,
+				struct dentry *real,
+				struct list_head *old_oes)
+{
+	struct ovl_inode *oi = OVL_I(inode);
+	struct ovl_entry *old_oe = oi->oe, *new_oe;
+	struct ovl_path *nstack, *ostack;
+	struct ovl_dyn_oldoe *old;
+	unsigned int n;
+
+	if (ovl_entry_has_layer(old_oe, layer))
+		return 0;	/* option replay or retried walk */
+
+	old = kmalloc_obj(*old, GFP_KERNEL);
+	if (!old)
+		return -ENOMEM;
+
+	n = ovl_numlower(old_oe);
+	new_oe = ovl_alloc_entry(n + 1);
+	if (!new_oe) {
+		kfree(old);
+		return -ENOMEM;
+	}
+
+	nstack = ovl_lowerstack(new_oe);
+	ostack = ovl_lowerstack(old_oe);
+	nstack[0].dentry = dget(real);
+	nstack[0].layer = layer;
+	ovl_stack_cpy(nstack + 1, ostack, n);
+
+	WRITE_ONCE(oi->oe, new_oe);
+	/* the merged readdir cache of this dir must be rebuilt */
+	WRITE_ONCE(oi->version, oi->version + 1);
+	ovl_dyn_rekey_inode(inode, new_oe);
+
+	old->oe = old_oe;
+	list_add(&old->node, old_oes);
+	return 0;
+}
+
+/*
+ * Make @child permanently stale relative to the mount's current
+ * generation: ofs->dyn_gen only ever increases (see ovl_dyn_bump_gen()),
+ * so restamping @child with its own current value minus one can never
+ * again match a live dyn_gen.  The next revalidation of @child that
+ * finds it no longer mount-shadowed will invalidate and re-look-up
+ * it - the same self-heal ovl_dentry_revalidate_common() already
+ * gives every dentry whose generation mismatches (see there) - without
+ * touching dyn_gen itself, which would mark every OTHER cached dentry
+ * stale too.
+ */
+static void ovl_dyn_mark_stale(struct dentry *child)
+{
+	ovl_dentry_restamp_gen(child, ovl_dentry_gen(child) - 1);
+}
+
+/*
+ * Invalidate a cached overlay child that the added layer affects.
+ * Mount-carrying dentries are left alone (the mount shadows the
+ * overlay content anyway; see ovl_dentry_revalidate_common()), but
+ * marked stale so they self-heal once the mount goes away, instead of
+ * silently keeping pre-add content forever.
+ */
+static void ovl_dyn_kick_child(struct dentry *child, bool mod_is_dir)
+{
+	if (d_mountpoint(child)) {
+		ovl_dyn_mark_stale(child);
+		return;
+	}
+	if (child->d_inode && d_is_dir(child)) {
+		/* module dir merging into a cached dir: handled by walk */
+		if (mod_is_dir)
+			return;
+		/* type change: module file shadows a lower dir */
+		if (ovl_dyn_has_submounts(child)) {
+			ovl_dyn_mark_stale(child);
+			return;
+		}
+	}
+	d_invalidate(child);
+}
+
+static int ovl_dyn_surgical_add(struct super_block *sb,
+				struct ovl_layer *layer,
+				struct list_head *old_oes)
+{
+	struct ovl_fs *ofs = OVL_FS(sb);
+	struct mnt_idmap *idmap = mnt_idmap(layer->mnt);
+	LIST_HEAD(queue);
+	struct ovl_dyn_qitem *qi, *qtmp;
+	struct ovl_dyn_dirent *ent;
+	long budget = 200000;
+	int err;
+
+	err = ovl_dyn_queue(&queue, dget(sb->s_root),
+			    dget(layer->mnt->mnt_root));
+	if (err) {
+		dput(sb->s_root);
+		dput(layer->mnt->mnt_root);
+		return err;
+	}
+
+	while (!list_empty(&queue)) {
+		struct ovl_dyn_rdd rdd = {
+			.ctx.actor = ovl_dyn_filldir,
+			.ctx.count = INT_MAX,
+			.entries = LIST_HEAD_INIT(rdd.entries),
+			.budget = &budget,
+		};
+		struct path realpath;
+		struct file *realfile;
+
+		qi = list_first_entry(&queue, struct ovl_dyn_qitem, node);
+		list_del(&qi->node);
+
+		realpath.mnt = layer->mnt;
+		realpath.dentry = qi->real;
+
+		err = -EOPNOTSUPP;
+		/*
+		 * The module's own directory can carry a baked-in opaque
+		 * marker or redirect xattr just as well at its top level
+		 * as at any deeper level; check it for every queue item,
+		 * including the root (whose stack insertion is handled
+		 * separately below), not just non-root ones.  Missing this
+		 * for the root would surgically merge a module whose own
+		 * root the checks exist specifically to catch.
+		 */
+		if (ovl_get_opaquedir_val(ofs, &realpath) == 'y')
+			goto out_entries;
+		if (ovl_path_getxattr(ofs, &realpath, OVL_XATTR_REDIRECT,
+				      NULL, 0) >= 0)
+			goto out_entries;
+		if (qi->ovl != sb->s_root) {
+			/*
+			 * A cached dir that is itself opaque was built
+			 * with an empty lower stack on purpose (nothing
+			 * below its upper is meant to be visible); inserting
+			 * a layer into it would surface content it must
+			 * hide.  Fall back instead.
+			 */
+			if (ovl_dentry_is_opaque(qi->ovl))
+				goto out_entries;
+			/*
+			 * A cached dir with a redirect does not live at
+			 * its name-derived position: it was paired with
+			 * qi->real by matching names under its parent, but
+			 * its real lower counterpart is wherever the
+			 * redirect points, not wherever this name would
+			 * suggest.  Surgically inserting by name here (or
+			 * trusting name-matched children below it) could
+			 * merge into the wrong place.  Unlike the mount-
+			 * wide "any redirect anywhere, ever" latch this
+			 * replaces, only a directory the walk actually
+			 * reaches falls back.
+			 */
+			if (ovl_dentry_get_redirect(qi->ovl))
+				goto out_entries;
+			err = ovl_dyn_insert_lower(d_inode(qi->ovl), layer,
+						   qi->real, old_oes);
+			if (err)
+				goto out_entries;
+		}
+
+		realfile = ovl_path_open(&realpath, O_RDONLY);
+		if (IS_ERR(realfile)) {
+			err = PTR_ERR(realfile);
+			goto out_entries;
+		}
+		/*
+		 * A single iterate_dir() call is not guaranteed to reach
+		 * the end of the directory (e.g. a signal, or some lower
+		 * fs types, can make it return early with ctx.pos updated
+		 * but rdd.entries only partially filled); keep calling it,
+		 * same as ovl_dir_read(), until a call adds nothing more.
+		 */
+		do {
+			rdd.count = 0;
+			rdd.err = 0;
+			err = iterate_dir(realfile, &rdd.ctx);
+			if (!err)
+				err = rdd.err;
+		} while (!err && rdd.count);
+		fput(realfile);
+		if (err)
+			goto out_entries;
+
+		list_for_each_entry(ent, &rdd.entries, node) {
+			struct qstr q = QSTR_LEN(ent->name, ent->len);
+			struct dentry *ovlchild, *realchild = NULL;
+			bool mod_is_dir;
+
+			ovlchild = d_hash_and_lookup(qi->ovl, &q);
+			if (!ovlchild)
+				continue;
+
+			if (ent->d_type != DT_UNKNOWN) {
+				mod_is_dir = ent->d_type == DT_DIR;
+			} else {
+				/*
+				 * Keep this reference: if we end up
+				 * descending below, reuse it instead of
+				 * looking the same name up a second time.
+				 */
+				realchild = lookup_one_unlocked(idmap, &q,
+								qi->real);
+				if (IS_ERR(realchild)) {
+					err = PTR_ERR(realchild);
+					dput(ovlchild);
+					goto out_entries;
+				}
+				mod_is_dir = d_is_dir(realchild);
+			}
+
+			if (mod_is_dir && ovlchild->d_inode &&
+			    d_is_dir(ovlchild)) {
+				/* descend: merge into the cached child dir */
+				if (!realchild) {
+					realchild = lookup_one_unlocked(idmap, &q,
+									qi->real);
+					if (IS_ERR(realchild)) {
+						err = PTR_ERR(realchild);
+						dput(ovlchild);
+						goto out_entries;
+					}
+				}
+				err = ovl_dyn_queue(&queue, ovlchild,
+						    realchild);
+				if (err) {
+					dput(ovlchild);
+					dput(realchild);
+					goto out_entries;
+				}
+				continue;
+			}
+
+			dput(realchild);
+			ovl_dyn_kick_child(ovlchild, mod_is_dir);
+			dput(ovlchild);
+		}
+
+		err = 0;
+out_entries:
+		/*
+		 * Common cleanup for both the success path (falls through
+		 * here with err == 0) and every early-exit goto above
+		 * (which always sets err first); freeing rdd.entries is
+		 * a no-op wherever it is still empty.
+		 */
+		ovl_dyn_free_dirents(&rdd.entries);
+		dput(qi->ovl);
+		dput(qi->real);
+		kfree(qi);
+		if (err)
+			goto out_queue;
+		continue;
+	}
+	return 0;
+
+out_queue:
+	list_for_each_entry_safe(qi, qtmp, &queue, node) {
+		dput(qi->ovl);
+		dput(qi->real);
+		kfree(qi);
+	}
+	return err;
+}
+
+/*
+ * Fallback invalidation: declare every dentry stale via the global
+ * generation.  Always correct, at the price of a cold dentry cache.
+ * Caller must hold ofs->dyn_lock for writing and call
+ * shrink_dcache_sb() after dropping it.
+ */
+static void ovl_dyn_bump_gen(struct super_block *sb)
+{
+	struct ovl_fs *ofs = OVL_FS(sb);
+	unsigned long gen;
+
+	gen = atomic_long_inc_return(&ofs->dyn_gen);
+	ovl_dentry_restamp_gen(sb->s_root, gen);
+}
+
+static void ovl_dyn_release_fsid(struct ovl_fs *ofs, int fsid);
+
+int ovl_dyn_add_layer(struct super_block *sb, const char *name,
+		      const struct path *path)
+{
+	struct ovl_fs *ofs = OVL_FS(sb);
+	struct inode *root_inode = ovl_root_inode(sb);
+	struct ovl_entry *old_oe, *new_oe, *cur_oe;
+	struct ovl_path *nstack, *ostack;
+	struct ovl_layer *layer;
+	struct vfsmount *mnt;
+	struct inode *trap = NULL;
+	struct ovl_dyn_oldoe *oldoe, *oldtmp;
+	LIST_HEAD(old_oes);
+	char *dup_name;
+	unsigned int n, idx;
+	int fsid = -1, err;
+
+	if (!ovl_dyn_enabled(ofs))
+		return -EOPNOTSUPP;
+
+	/* reuse a slot released by a removed layer, if any */
+	idx = ovl_find_free_slot(ofs->layers, ofs->numlayer, mnt);
+	if (idx == ofs->numlayer && ofs->numlayer >= ofs->numlayer_cap)
+		return -ENOSPC;
+
+	err = ovl_dyn_check_lower(sb, ofs, path);
+	if (err)
+		return err;
+
+	if (ovl_dyn_find_layer(ofs, path->dentry))
+		return -EEXIST;
+
+	err = ovl_check_namelen(path, ofs, name);
+	if (err)
+		return err;
+
+	/*
+	 * Check file handle support: runtime-added layers must meet the
+	 * same xino constraints as mount-time layers, or file numbers
+	 * (st_dev, st_ino) could collide with existing files.
+	 */
+	if (ovl_can_decode_fh(path->dentry->d_sb) != FILEID_INO32_GEN)
+		WRITE_ONCE(ofs->xino_mode, -1);
+
+	dup_name = kstrdup(name, GFP_KERNEL);
+	if (!dup_name)
+		return -ENOMEM;
+
+	/*
+	 * Serialized against other add/del by s_umount (held by the
+	 * reconfigure path).  ovl_get_fsid() and the layer slot are
+	 * filled before the layer is published via the root ovl_entry.
+	 */
+	err = fsid = ovl_get_fsid(ofs, path);
+	if (fsid < 0)
+		goto out_name;
+
+	err = ovl_setup_trap(sb, path->dentry, &trap, "lowerdir");
+	if (err)
+		goto out_trap;
+
+	/* refuse layers overlapping with other layers or upper/work dirs */
+	err = ovl_check_layer(sb, ofs, path->dentry, "lowerdir", true);
+	if (err)
+		goto out_trap;
+
+	if (ovl_is_inuse(path->dentry)) {
+		err = ovl_report_in_use(ofs, "lowerdir");
+		if (err)
+			goto out_trap;
+	}
+
+	mnt = clone_private_mount(path);
+	if (IS_ERR(mnt)) {
+		err = PTR_ERR(mnt);
+		goto out_trap;
+	}
+	mnt->mnt_flags |= MNT_READONLY | MNT_NOATIME;
+
+	/*
+	 * Build the new root stack: the new layer goes on top of the
+	 * read-only stack, above all current lower layers.
+	 */
+	cur_oe = OVL_I_E(root_inode);
+	n = ovl_numlower(cur_oe);
+	new_oe = ovl_alloc_entry(n + 1);
+	if (!new_oe) {
+		err = -ENOMEM;
+		goto out_mnt;
+	}
+
+	layer = &ofs->layers[idx];
+
+	nstack = ovl_lowerstack(new_oe);
+	ostack = ovl_lowerstack(cur_oe);
+	nstack[0].dentry = dget(path->dentry);
+	nstack[0].layer = layer;
+	ovl_stack_cpy(nstack + 1, ostack, n);
+
+	inode_lock(root_inode);
+	down_write(&ofs->dyn_lock);
+	/*
+	 * With a reused slot (idx < numlayer), a concurrent reader may
+	 * be holding dyn_lock for reading right up until down_write()
+	 * above returns and may walk ofs->layers[] by raw index (e.g.
+	 * ovl_check_origin_fh()); populate the slot only now, once no
+	 * such reader can be in flight, instead of before dyn_lock is
+	 * held where a torn/partial slot could be observed.
+	 */
+	layer->trap = trap;
+	layer->mnt = mnt;
+	layer->idx = idx;
+	layer->fsid = fsid;
+	layer->fs = &ofs->fs[fsid];
+	layer->has_xwhiteouts = false;
+	ofs->fs[fsid].is_lower = true;
+	ofs->config.lowerdirs[idx] = dup_name;
+	if (idx == ofs->numlayer)
+		ofs->numlayer++;
+	old_oe = ovl_dyn_swap_root(sb, new_oe);
+	inode_unlock(root_inode);
+
+	/*
+	 * Fix up the cached state surgically, still excluding lookups:
+	 * they must not instantiate entries from directories that do
+	 * not know about the new layer yet.  If anything goes wrong,
+	 * fall back to invalidating everything via the generation.
+	 */
+	err = ovl_dyn_surgical_add(sb, layer, &old_oes);
+	if (err)
+		ovl_dyn_bump_gen(sb);
+	up_write(&ofs->dyn_lock);
+
+	/*
+	 * Wait out lockless readers (revalidation, ovl_path_type(),
+	 * path helpers) of the superseded stacks before dropping them.
+	 */
+	synchronize_rcu();
+	ovl_free_entry(old_oe);
+	list_for_each_entry_safe(oldoe, oldtmp, &old_oes, node) {
+		ovl_free_entry(oldoe->oe);
+		kfree(oldoe);
+	}
+
+	if (err) {
+		/*
+		 * Flush all unpinned dentries eagerly: it keeps the
+		 * number of stale entries that revalidation has to deal
+		 * with (and walk for submounts) small.
+		 */
+		shrink_dcache_sb(sb);
+		pr_info("layer '%s' added to overlay (full cache invalidation)\n",
+			name);
+	} else {
+		pr_info("layer '%s' added to overlay\n", name);
+	}
+	return 0;
+
+out_mnt:
+	mntput(mnt);
+out_trap:
+	iput(trap);
+	/*
+	 * A newly allocated fs[] slot (anon bdev + sb pointer) is not
+	 * yet referenced by any layer at this point; release it here
+	 * so a failed add does not permanently consume a slot from the
+	 * fixed-size fs table (see ovl_dyn_release_fsid()).
+	 */
+	ovl_dyn_release_fsid(ofs, fsid);
+out_name:
+	kfree(dup_name);
+	return err;
+}
+
+/* Does @oe reference @layer? */
+static bool ovl_entry_has_layer(struct ovl_entry *oe,
+				const struct ovl_layer *layer)
+{
+	return ovl_stack_find_layer(oe, layer) < ovl_numlower(oe);
+}
+
+struct ovl_dyn_scan {
+	struct inode **dirs;
+	unsigned int nr;
+	unsigned int cap;
+	unsigned int nr_busy;
+};
+
+static bool ovl_dyn_scan_seen(struct ovl_dyn_scan *scan, struct inode *inode)
+{
+	unsigned int i;
+
+	for (i = 0; i < scan->nr; i++) {
+		if (scan->dirs[i] == inode)
+			return true;
+	}
+	return false;
+}
+
+/*
+ * Drop every cache-only reference to @layer and classify what remains:
+ * in-use non-directories make the layer busy, while in-use directories
+ * (typically ancestors of running binaries, like /usr, or working
+ * directories) are collected so their layer stacks can be rebuilt
+ * without the layer afterwards.
+ *
+ * Caller holds the root inode lock and ofs->dyn_lock for writing, so
+ * no new references can appear while we look: every ovl_lookup()
+ * takes dyn_lock for reading.  Collected inodes hold a reference and
+ * must be iput by the caller.
+ */
+static int ovl_dyn_scan_layer(struct super_block *sb,
+			      const struct ovl_layer *layer,
+			      struct ovl_dyn_scan *scan,
+			      bool force_shrink, bool *dcache_fresh)
+{
+	struct inode *inode;
+
+	/*
+	 * Drop all unpinned dentries; their inodes go with them.  Then
+	 * evict, in one pass, the unreferenced inodes that survive
+	 * without any alias (hashed non-dirs): the dentry cache is
+	 * already cold sb-wide, so purging every unused inode instead
+	 * of only this layer's costs nothing extra and spares the scan
+	 * below its per-inode evict-and-restart dance, which was
+	 * quadratic in the number of cached inodes.  A batch of
+	 * removals in one remount shares a single shrink+purge for
+	 * their first attempt (nothing about removing a different layer
+	 * changes this layer's reference counts); a retry within one
+	 * layer's own removal always redoes both, since it only happens
+	 * after a copy-up changed reference counts.
+	 */
+	if (force_shrink || !*dcache_fresh) {
+		shrink_dcache_sb(sb);
+		evict_inodes(sb);
+		*dcache_fresh = true;
+	}
+
+	/*
+	 * The eviction branch below now only catches an inode whose
+	 * last reference was dropped after evict_inodes() above ran
+	 * (e.g. a racing close); everything unreferenced before that
+	 * is already gone.
+	 */
+again:
+	scan->nr_busy = 0;
+	spin_lock(&sb->s_inode_list_lock);
+	list_for_each_entry(inode, &sb->s_inodes, i_sb_list) {
+		if (inode == ovl_root_inode(sb))
+			continue;
+		spin_lock(&inode->i_lock);
+		if ((inode_state_read(inode) & (I_FREEING | I_WILL_FREE | I_NEW)) ||
+		    !ovl_entry_has_layer(OVL_I_E(inode), layer) ||
+		    ovl_dyn_scan_seen(scan, inode)) {
+			spin_unlock(&inode->i_lock);
+			continue;
+		}
+		if (atomic_read(&inode->i_count)) {
+			if (!S_ISDIR(inode->i_mode)) {
+				/* genuinely in use (open file, mmap, ...) */
+				scan->nr_busy++;
+				spin_unlock(&inode->i_lock);
+				continue;
+			}
+			/* in-use directory: collect for stack rebuild */
+			if (scan->nr == scan->cap) {
+				unsigned int cap = max(16U, scan->cap * 2);
+				struct inode **d;
+
+				d = krealloc_array(scan->dirs, cap,
+						   sizeof(*d), GFP_ATOMIC);
+				if (!d) {
+					spin_unlock(&inode->i_lock);
+					spin_unlock(&sb->s_inode_list_lock);
+					return -ENOMEM;
+				}
+				scan->dirs = d;
+				scan->cap = cap;
+			}
+			/* open-coded __iget(), not usable by modules */
+			atomic_inc(&inode->i_count);
+			scan->dirs[scan->nr++] = inode;
+			spin_unlock(&inode->i_lock);
+			continue;
+		}
+		/* cached and unreferenced: make iput() evict it */
+		inode_state_set(inode, I_DONTCACHE);
+		/* open-coded __iget(), not usable by modules */
+		atomic_inc(&inode->i_count);
+		spin_unlock(&inode->i_lock);
+		spin_unlock(&sb->s_inode_list_lock);
+
+		/*
+		 * I_DONTCACHE makes this iput evict the inode right
+		 * away.  Evicting before the rescan matters: an inode
+		 * still held here would be counted busy by the final
+		 * pass and fail the removal with a spurious -EBUSY.
+		 * We dropped the list lock, restart the scan.  Progress
+		 * is guaranteed: the evicted inode cannot be found
+		 * again.
+		 */
+		iput(inode);
+		goto again;
+	}
+	spin_unlock(&sb->s_inode_list_lock);
+
+	return 0;
+}
+
+/*
+ * Give every collected in-use directory an upper dentry: after the
+ * stack rebuild, operations like permission, getattr and xattr then
+ * resolve through the (stable) upper dentry and never look at the
+ * swapped stack.  A directory copy-up only creates an empty directory
+ * in the upper layer and copies attributes over - a few bytes.
+ */
+static int ovl_dyn_copy_up_dirs(struct ovl_dyn_scan *scan)
+{
+	unsigned int i;
+	int err = 0;
+
+	for (i = 0; !err && i < scan->nr; i++) {
+		struct inode *inode = scan->dirs[i];
+		struct dentry *alias;
+
+		if (ovl_i_dentry_upper(inode))
+			continue;
+		alias = d_find_alias(inode);
+		if (!alias)
+			continue;	/* not reachable by path walks */
+		err = ovl_copy_up(alias);
+		dput(alias);
+	}
+	return err;
+}
+
+/*
+ * Prepare the replacement layer stack of an in-use directory without
+ * @layer.  Called with the layer stacks stable (root inode lock and
+ * ofs->dyn_lock held for writing), so the commit step cannot fail.
+ * Returns NULL if the directory no longer references the layer.
+ */
+static struct ovl_entry *ovl_dyn_prep_rebuild(struct inode *inode,
+					      const struct ovl_layer *layer)
+{
+	struct ovl_entry *old_oe = OVL_I_E(inode), *new_oe;
+	struct ovl_path *nstack, *ostack;
+	unsigned int i, j, n, hits = 0;
+
+	n = ovl_numlower(old_oe);
+	ostack = ovl_lowerstack(old_oe);
+	for (i = 0; i < n; i++) {
+		if (ostack[i].layer == layer)
+			hits++;
+	}
+	if (!hits)
+		return NULL;
+
+	new_oe = ovl_alloc_entry(n - hits);
+	if (!new_oe)
+		return ERR_PTR(-ENOMEM);
+
+	nstack = ovl_lowerstack(new_oe);
+	for (i = 0, j = 0; i < n; i++) {
+		if (ostack[i].layer == layer)
+			continue;
+		nstack[j].dentry = dget(ostack[i].dentry);
+		nstack[j].layer = ostack[i].layer;
+		j++;
+	}
+	return new_oe;
+}
+
+/*
+ * Swap in the prepared stack of an in-use directory.  The superseded
+ * entry is not freed but parked on the inode (see @parked, allocated
+ * by the caller), with the removed layer's mount pinned, until the
+ * inode is evicted: an operation on this directory that resolved a
+ * lower path before its copy-up (e.g. getattr, permission) may sleep
+ * holding pointers into the old stack for longer than any grace
+ * period, and it holds the inode alive for its whole duration.
+ * Lockless readers (revalidation, ovl_path_type()) are covered the
+ * same way.
+ */
+static void ovl_dyn_commit_rebuild(struct ovl_fs *ofs,
+				   struct inode *inode,
+				   struct ovl_entry *new_oe,
+				   const struct ovl_layer *layer,
+				   struct ovl_dyn_parked *parked)
+{
+	struct ovl_inode *oi = OVL_I(inode);
+	struct ovl_entry *old_oe;
+	struct dentry *alias;
+	unsigned long gen;
+
+	/*
+	 * Do not take inode_lock() here: the caller already holds
+	 * ofs->dyn_lock for writing, which alone is sufficient to
+	 * exclude every other oe reader/writer in dynamic layers mode
+	 * (ovl_lookup(), ovl_lower_positive(), ovl_dyn_insert_lower()
+	 * all serialize on dyn_lock, not on this directory's inode
+	 * lock).  Taking inode_lock() in addition would deadlock
+	 * against a concurrent lookup: real_lookup() holds the
+	 * parent's inode_lock (shared) before calling ->lookup(),
+	 * which then blocks on down_read(&ofs->dyn_lock) here - ABBA
+	 * with this function's inode_lock(inode) + dyn_lock(write).
+	 * The i_lock below is what actually protects the i_dentry
+	 * alias list, independent of inode_lock.
+	 */
+	old_oe = oi->oe;
+	WRITE_ONCE(oi->oe, new_oe);
+	/* the merged readdir cache of this dir must be rebuilt */
+	oi->version++;
+	ovl_dyn_rekey_inode(inode, new_oe);
+
+	parked->oe = old_oe;
+	parked->mnt = mntget(layer->mnt);
+	parked->next = oi->dyn_parked;
+	oi->dyn_parked = parked;
+
+	/*
+	 * The stack is fresh again: restamp the dentries so that they
+	 * are not flushed (and aliased) by revalidation.
+	 */
+	gen = (unsigned long)atomic_long_read(&ofs->dyn_gen);
+	spin_lock(&inode->i_lock);
+	hlist_for_each_entry(alias, &inode->i_dentry, d_alias)
+		ovl_dentry_restamp_gen(alias, gen);
+	spin_unlock(&inode->i_lock);
+}
+
+/*
+ * Drop the dentry references and pinned mounts of the stacks parked
+ * on @oi.  Called from ovl_destroy_inode(): eviction means no
+ * operation can be using them anymore, only the structs must stay
+ * around for lockless readers until the RCU-delayed free below.
+ */
+void ovl_dyn_put_parked(struct ovl_inode *oi)
+{
+	struct ovl_dyn_parked *p;
+
+	for (p = oi->dyn_parked; p; p = p->next) {
+		ovl_stack_put(ovl_lowerstack(p->oe), ovl_numlower(p->oe));
+		mntput(p->mnt);
+	}
+}
+
+/* Called from ovl_free_inode(), after an RCU grace period */
+void ovl_dyn_free_parked(struct ovl_inode *oi)
+{
+	struct ovl_dyn_parked *p, *next;
+
+	for (p = oi->dyn_parked; p; p = next) {
+		next = p->next;
+		kfree(p->oe);
+		kfree(p);
+	}
+	oi->dyn_parked = NULL;
+}
+
+/*
+ * Release the fsid of a removed layer if no other layer shares it, so
+ * that activate/deactivate cycles do not deplete the fs table.
+ */
+static void ovl_dyn_release_fsid(struct ovl_fs *ofs, int fsid)
+{
+	struct ovl_sb *fs;
+	unsigned int i;
+
+	if (fsid <= 0)
+		return;
+	fs = &ofs->fs[fsid];
+	for (i = 1; i < ofs->numlayer; i++) {
+		if (ofs->layers[i].mnt && ofs->layers[i].fs == fs)
+			return;	/* still shared with a live layer */
+	}
+	free_anon_bdev(fs->pseudo_dev);
+	fs->pseudo_dev = 0;
+	fs->sb = NULL;
+	fs->bad_uuid = false;
+	fs->is_lower = false;
+}
+
+int ovl_dyn_del_layer(struct super_block *sb, const struct path *path,
+		      bool *dcache_fresh)
+{
+	struct ovl_fs *ofs = OVL_FS(sb);
+	struct inode *root_inode = ovl_root_inode(sb);
+	struct ovl_entry *new_oe, *cur_oe, *old_root_oe;
+	struct ovl_entry **new_oes = NULL;
+	struct ovl_dyn_parked **parked = NULL;
+	struct ovl_path *nstack, *ostack;
+	struct ovl_layer *layer;
+	struct ovl_dyn_scan scan = {};
+	unsigned int i, n, j, tries;
+	int err;
+
+	if (!ovl_dyn_enabled(ofs))
+		return -EOPNOTSUPP;
+
+	layer = ovl_dyn_find_layer(ofs, path->dentry);
+	if (!layer)
+		return -ENOENT;
+
+	cur_oe = OVL_I_E(root_inode);
+	n = ovl_numlower(cur_oe);
+	if (n < 2)
+		return -EINVAL;	/* never remove the last lower layer */
+
+	new_oe = ovl_alloc_entry(n - 1);
+	if (!new_oe)
+		return -ENOMEM;
+
+	for (tries = 0; ; tries++) {
+		inode_lock(root_inode);
+		down_write(&ofs->dyn_lock);
+
+		err = ovl_dyn_scan_layer(sb, layer, &scan, tries > 0, dcache_fresh);
+		if (err)
+			goto out_unlock;
+
+		if (scan.nr_busy) {
+			pr_info("cannot remove layer '%s': %u file(s) in use\n",
+				ofs->config.lowerdirs[layer->idx], scan.nr_busy);
+			err = -EBUSY;
+			goto out_unlock;
+		}
+
+		/*
+		 * All collected in-use directories need an upper dentry
+		 * before their stacks can be rebuilt (see
+		 * ovl_dyn_copy_up_dirs()).  Copying up takes locks we
+		 * hold, so drop them, copy up, and try again (up to 4
+		 * times): the world may have changed meanwhile.
+		 */
+		for (i = 0; i < scan.nr; i++) {
+			if (!ovl_i_dentry_upper(scan.dirs[i]))
+				break;
+		}
+		if (i == scan.nr)
+			break;
+
+		up_write(&ofs->dyn_lock);
+		inode_unlock(root_inode);
+
+		err = -EBUSY;
+		if (tries >= 4)
+			goto out_scan;
+		err = ovl_dyn_copy_up_dirs(&scan);
+		if (err)
+			goto out_scan;
+		for (i = 0; i < scan.nr; i++)
+			iput(scan.dirs[i]);
+		scan.nr = 0;
+	}
+
+	/*
+	 * Prepare the replacement stacks and their parking records
+	 * while everything is stable, so that nothing can fail after
+	 * the root stack is swapped.
+	 */
+	err = -ENOMEM;
+	new_oes = kcalloc(scan.nr, sizeof(*new_oes), GFP_KERNEL);
+	if (!new_oes)
+		goto out_unlock;
+	parked = kcalloc(scan.nr, sizeof(*parked), GFP_KERNEL);
+	if (!parked)
+		goto out_unlock;
+	for (i = 0; i < scan.nr; i++) {
+		new_oes[i] = ovl_dyn_prep_rebuild(scan.dirs[i], layer);
+		if (IS_ERR(new_oes[i])) {
+			new_oes[i] = NULL;
+			goto out_unlock;
+		}
+		if (!new_oes[i])
+			continue;
+		parked[i] = kmalloc_obj(*parked[i], GFP_KERNEL);
+		if (!parked[i])
+			goto out_unlock;
+	}
+
+	err = 0;
+	nstack = ovl_lowerstack(new_oe);
+	ostack = ovl_lowerstack(cur_oe);
+	for (i = 0, j = 0; i < n; i++) {
+		if (ostack[i].layer == layer)
+			continue;
+		if (WARN_ON(j >= n - 1)) {
+			err = -EIO;
+			goto out_unlock;
+		}
+		nstack[j].dentry = dget(ostack[i].dentry);
+		nstack[j].layer = ostack[i].layer;
+		j++;
+	}
+
+	old_root_oe = ovl_dyn_swap_root(sb, new_oe);
+
+	/*
+	 * Swap in the prepared stacks of the collected in-use
+	 * directories before releasing dyn_lock: a lookup through one
+	 * of these directories takes dyn_lock for reading, so as long
+	 * as we still hold it for writing here, no lookup can resolve
+	 * a child through a stack that still references the removed
+	 * layer.  Releasing the lock between the root swap and these
+	 * per-directory commits would leave exactly that window open.
+	 */
+	for (i = 0; i < scan.nr; i++) {
+		if (new_oes[i])
+			ovl_dyn_commit_rebuild(ofs, scan.dirs[i],
+					       new_oes[i], layer, parked[i]);
+		iput(scan.dirs[i]);
+	}
+	kfree(scan.dirs);
+	kfree(new_oes);
+	kfree(parked);
+
+	pr_info("layer '%s' removed from overlay\n",
+		ofs->config.lowerdirs[layer->idx]);
+	/*
+	 * Every reader of config.lowerdirs[] past mount time takes
+	 * dyn_lock: ovl_show_options() takes it for reading around the
+	 * whole lowerdir+/datadir+ printing loop, and this function
+	 * (like ovl_dyn_add_layer()) holds it for writing here.  That
+	 * fully excludes a concurrent /proc/mounts reader from this
+	 * slot, so the name can be freed immediately instead of leaked.
+	 */
+	kfree(ofs->config.lowerdirs[layer->idx]);
+	ofs->config.lowerdirs[layer->idx] = NULL;
+
+	/*
+	 * Free the slot for reuse by a later layer addition, still
+	 * under dyn_lock: mnt == NULL marks the slot as free, and every
+	 * reader that walks ofs->layers[] by raw index while holding
+	 * dyn_lock (e.g. ovl_check_origin_fh() during a lookup) must
+	 * never observe a slot whose mnt/fs/fsid have only been
+	 * partially cleared.  Doing this after up_write() would let
+	 * such a reader see mnt == NULL while fs/fsid are still the
+	 * stale values, or vice versa.
+	 */
+	iput(layer->trap);
+	layer->trap = NULL;
+	mntput(layer->mnt);
+	layer->mnt = NULL;
+	ovl_dyn_release_fsid(ofs, layer->fsid);
+	layer->fs = NULL;
+	layer->fsid = 0;
+
+	up_write(&ofs->dyn_lock);
+	inode_unlock(root_inode);
+
+	/*
+	 * Wait out lockless readers of the superseded root stack, then
+	 * drop it.  The root always resolves through its (stable) upper
+	 * dentry outside of lookup/readdir/statfs, which take dyn_lock,
+	 * so unlike the per-directory stacks parked above it needs no
+	 * parking beyond this grace period.  The removed layer itself
+	 * stays pinned only by whatever is parked on still-living
+	 * directory inodes and goes away with them.
+	 */
+	synchronize_rcu();
+	ovl_free_entry(old_root_oe);
+
+	return 0;
+
+out_unlock:
+	up_write(&ofs->dyn_lock);
+	inode_unlock(root_inode);
+out_scan:
+	for (i = 0; i < scan.nr; i++)
+		iput(scan.dirs[i]);
+	kfree(scan.dirs);
+	if (new_oes) {
+		for (i = 0; i < scan.nr; i++) {
+			if (new_oes[i])
+				ovl_free_entry(new_oes[i]);
+		}
+		kfree(new_oes);
+	}
+	if (parked) {
+		for (i = 0; i < scan.nr; i++)
+			kfree(parked[i]);
+		kfree(parked);
+	}
+	ovl_free_entry(new_oe);
+	return err;
+}
+
+/*
+ * Called from ovl_reconfigure() with sb->s_umount held for writing.
+ * Applies the lowerdir+= additions collected in @ctx->lower and the
+ * lowerdir-= removals collected in @ctx->dyn_del.
+ */
+int ovl_dyn_reconfigure(struct fs_context *fc)
+{
+	struct super_block *sb = fc->root->d_sb;
+	struct ovl_fs_context *ctx = fc->fs_private;
+	bool dcache_fresh = false;
+	size_t i;
+	int err = 0;
+
+	for (i = 0; !err && i < ctx->nr; i++) {
+		struct ovl_fs_context_layer *l = &ctx->lower[i];
+
+		err = ovl_dyn_add_layer(sb, l->name, &l->path);
+		/*
+		 * Tolerate re-adding a present layer: legacy remounts
+		 * may replay the current mount options.
+		 */
+		if (err == -EEXIST)
+			err = 0;
+	}
+
+	/*
+	 * dcache_fresh is shared across the whole batch of removals
+	 * below: removing one layer doesn't change another layer's
+	 * reference counts, so only the first removal's first attempt
+	 * needs to shrink the dentry cache (see ovl_dyn_scan_layer()).
+	 */
+	for (i = 0; !err && i < ctx->nr_dyn_del; i++)
+		err = ovl_dyn_del_layer(sb, &ctx->dyn_del[i], &dcache_fresh);
+
+	return err;
+}
