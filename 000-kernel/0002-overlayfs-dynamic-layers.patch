+	if (ovl_dentry_casefolded(dentry) != ofs->casefold)
+		return -EINVAL;
+	/*
+	 * Layers whose dentries need revalidation (remote fs) are not
+	 * supported in dynamic mode: root revalidation is short
+	 * circuited (see ovl_dentry_revalidate_common()).
+	 */
+	if (dentry->d_flags & (DCACHE_OP_REVALIDATE |
+			       DCACHE_OP_WEAK_REVALIDATE))
+		return -EINVAL;
+	/* the new layer must not bust the stacking depth of this sb */
+	if (path->mnt->mnt_sb->s_stack_depth >= sb->s_stack_depth)
